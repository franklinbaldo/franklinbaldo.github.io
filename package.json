{
  "name": "franklinbaldo-pico",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "node scripts/copy-katex.mjs && node scripts/generate-translation-pairs.mjs",
