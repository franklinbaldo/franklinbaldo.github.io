{
  "name": "franklinbaldo-pico",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "suno-rank": "scripts/suno-rank/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/pregen.mjs",
    "predev": "node scripts/pregen.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs && node scripts/check-embeds.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:embeds": "node scripts/check-embeds.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:player-payload": "node scripts/check-player-payload.mjs",
    "check:tags": "node scripts/check-tag-collisions.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "audiobook:validate": "node scripts/audiobook/validate.mjs",
    "audiobook:plan": "node scripts/audiobook/plan.mjs",
    "dev": "astro dev",
    "build": "astro build && npm run check:player-payload && node scripts/fix-redirect-html.mjs && pagefind --site dist && node --import tsx/esm scripts/generate-ranking-snapshot.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "music:sync": "node scripts/sync-suno-catalog.mjs",
    "suno-rank": "node --import tsx/esm scripts/suno-rank/index.js",
    "suno-rank:round": "node --import tsx/esm scripts/suno-rank/index.js round",
    "suno-rank:ranking": "node --import tsx/esm scripts/suno-rank/index.js ranking",
    "suno-rank:doctor": "node --import tsx/esm scripts/suno-rank/index.js doctor",
    "atlas:doctor": "python scripts/science-equations/doctor.py",
    "test": "node --import tsx/esm --experimental-test-module-mocks --test --test-concurrency=1 \"src/**/*.test.{js,ts}\"",
    "test:e2e": "node scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@picocss/pico": "^2.1.1",
    "astro": "^7.3.3",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "^5.11.1",
    "highlight.js": "^11.12.0",
    "image-size": "^2.0.4",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.1",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@lhci/cli": "^0.15.1",
    "depcheck": "^1.4.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "openskill": "^5.0.1",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "remark": "15.0.1",
    "tsx": "^4.23.13"
  }
}
