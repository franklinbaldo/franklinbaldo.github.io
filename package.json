    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "gray-matter": "^4.0.3",
    "openskill": "^4.1.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "remark": "15.0.1"
