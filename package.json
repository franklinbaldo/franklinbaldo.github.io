{
  "name": "franklinbaldo-pico",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "suno-rank": "scripts/suno-rank/index.js"
  },
  "scripts": {
    "check:hygiene": "node scripts/check-hygiene.mjs && node scripts/check-embeds.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:embeds": "node scripts/check-embeds.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:player-payload": "node scripts/check-player-payload.mjs",
    "check:tags": "node scripts/check-tag-collisions.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "audiobook:validate": "node scripts/audiobook/validate.mjs",
    "audiobook:plan": "node scripts/audiobook/plan.mjs",
    "dev": "node scripts/zola/serve.mjs --build --watch",
    "build": "node scripts/zola/build.mjs",
    "build:ssg": "node scripts/ssg/build.mjs",
    "preview": "node scripts/zola/serve.mjs",
    "format": "prettier --write scripts src zola",
    "format:check": "prettier --check scripts src zola",
    "lint": "oxlint",
    "music:sync": "node scripts/sync-suno-catalog.mjs",
    "suno-rank": "node --import tsx/esm scripts/suno-rank/index.js",
    "suno-rank:round": "node --import tsx/esm scripts/suno-rank/index.js round",
    "suno-rank:ranking": "node --import tsx/esm scripts/suno-rank/index.js ranking",
    "suno-rank:doctor": "node --import tsx/esm scripts/suno-rank/index.js doctor",
    "atlas:doctor": "python scripts/science-equations/doctor.py",
    "test": "node --import tsx/esm --experimental-test-module-mocks --test --test-concurrency=1 \"src/**/*.test.{js,ts}\"",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:ssg": "node scripts/ssg/check-architecture.mjs && node --test scripts/ssg/*.test.mjs",
    "tiers:check:posts": "uv run --with 'okf-parser @ git+https://github.com/franklinbaldo/okf-parser@e8ed6bbd93846a40ac17a0be88c658020e85443a' okf-parser check knowledge/blog-post-tiers --require-spec ../../specs/okf-types/{slug}.md --normative-spec",
    "tiers:check:music": "uv run --with 'okf-parser @ git+https://github.com/franklinbaldo/okf-parser@e8ed6bbd93846a40ac17a0be88c658020e85443a' okf-parser check knowledge/music-tiers --require-spec ../../specs/okf-types/{slug}.md --normative-spec",
    "tiers:check:projects": "uv run --with 'okf-parser @ git+https://github.com/franklinbaldo/okf-parser@e8ed6bbd93846a40ac17a0be88c658020e85443a' okf-parser check knowledge/project-tiers --require-spec ../../specs/okf-types/{slug}.md --normative-spec",
    "tiers:check:malecns": "uv run --with 'okf-parser @ git+https://github.com/franklinbaldo/okf-parser@e8ed6bbd93846a40ac17a0be88c658020e85443a' okf-parser check knowledge/malecns-projects --require-spec ../../specs/okf-types/{slug}.md --normative-spec",
    "tiers:check": "npm run tiers:check:posts && npm run tiers:check:music && npm run tiers:check:projects && npm run tiers:check:malecns",
    "build:zola": "node scripts/zola/build.mjs",
    "test:zola": "node --test scripts/zola/*.test.mjs scripts/zola/apps/*.test.mjs",
    "check:no-astro": "node scripts/check-no-astro.mjs"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@franklinbaldo/okf-parser": "0.45.7",
    "@picocss/pico": "^2.1.1",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.12.0",
    "image-size": "^2.0.4",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "depcheck": "^1.4.7",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "openskill": "^5.0.1",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "remark": "15.0.1",
    "tsx": "^4.23.15",
    "prettier": "3.9.10"
  }
}
