{
  "name": "franklinbaldo-pico",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "hronir": "scripts/hronir/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/pregen.mjs",
    "predev": "node scripts/pregen.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-redirect-html.mjs && pagefind --site dist && node --import tsx/esm scripts/generate-ranking-snapshot.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint",
    "hronir": "node --import tsx/esm scripts/hronir/index.js",
    "hronir:generate-match": "node --import tsx/esm scripts/hronir/index.js generate-match",
    "hronir:submit-eval": "node --import tsx/esm scripts/hronir/index.js submit-eval",
    "hronir:init": "node --import tsx/esm scripts/hronir/index.js init",
    "hronir:continue": "node --import tsx/esm scripts/hronir/index.js continue",
    "hronir:decide": "node --import tsx/esm scripts/hronir/index.js decide",
    "hronir:ranking": "node --import tsx/esm scripts/hronir/index.js ranking",
    "hronir:diagnose": "node --import tsx/esm scripts/hronir/index.js diagnose",
    "hronir:draft-worst": "node --import tsx/esm scripts/hronir/index.js draft-worst",
    "hronir:draft-commit": "node --import tsx/esm scripts/hronir/index.js draft-commit",
    "hronir:select": "node --import tsx/esm scripts/hronir/index.js select",
    "hronir:prune": "node --import tsx/esm scripts/hronir/index.js prune",
    "hronir:flatten": "node --import tsx/esm scripts/hronir/index.js flatten",
    "hronir:end": "node --import tsx/esm scripts/hronir/index.js end",
    "hronir:migrate": "node --import tsx/esm scripts/hronir/index.js migrate",
    "hronir:doctor": "node --import tsx/esm scripts/hronir/index.js doctor",
    "hronir:diagnose-corpus": "node --import tsx/esm scripts/hronir/diagnose-corpus.mjs",
    "music:generate": "node scripts/generate-music-posts.mjs",
    "test": "node --import tsx/esm --experimental-test-module-mocks --test --test-concurrency=1 \"src/**/*.test.{js,ts}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.0",
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@picocss/pico": "^2.1.1",
    "astro": "^7.0.3",
    "dompurify": "^3.4.11",
    "fast-xml-parser": "^5.8.0",
    "highlight.js": "^11.11.1",
    "image-size": "^2.0.2",
    "katex": "^0.17.0",
    "marked": "^18.0.5",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.14.0",
    "pagefind": "^1.5.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@lhci/cli": "^0.15.1",
    "depcheck": "^1.4.7",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "openskill": "^4.1.1",
    "oxlint": "^1.73.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "remark": "15.0.1",
    "tsx": "^4.22.4"
  }
}
