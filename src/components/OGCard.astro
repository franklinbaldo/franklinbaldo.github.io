---
// Handwritten OG card background (1200×630).
// Layout: large rectangular avatar on the left (vertically centered),
// text composited on the right by /og/[...slug].png.ts via sharp.

import { readFileSync } from "node:fs";
import { resolve } from "node:path";

const W = 1200;
const H = 630;
const TILE = 100;
const ACCENT_H = 10;

const AVATAR_SIZE = 320;
const AVATAR_X = 72;
const AVATAR_Y = Math.round((H - AVATAR_SIZE) / 2);
const AVATAR_RADIUS = 12;
const RING = 5;

const avatarPath = resolve(process.cwd(), "public/avatar.png");
const avatarB64 = readFileSync(avatarPath).toString("base64");
---

<svg xmlns="http://www.w3.org/2000/svg" width={W} height={H} viewBox={`0 0 ${W} ${H}`}>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1a1612" />
      <stop offset="1" stop-color="#221c16" />
    </linearGradient>
    <pattern id="cobogo" x="0" y="0" width={TILE} height={TILE} patternUnits="userSpaceOnUse">
      <g fill="none" stroke="#3a3026" stroke-width="0.9" opacity="0.75">
        <rect x="0" y="0" width={TILE/2} height={TILE/2} />
        <rect x={TILE/2} y="0" width={TILE/2} height={TILE/2} />
        <rect x="0" y={TILE/2} width={TILE/2} height={TILE/2} />
        <rect x={TILE/2} y={TILE/2} width={TILE/2} height={TILE/2} />
        <circle cx={TILE/4} cy={TILE/4} r={TILE*0.18} />
        <circle cx={TILE*3/4} cy={TILE/4} r={TILE*0.18} />
        <circle cx={TILE/4} cy={TILE*3/4} r={TILE*0.18} />
        <circle cx={TILE*3/4} cy={TILE*3/4} r={TILE*0.18} />
        <line x1="0" y1="0" x2={TILE/2} y2={TILE/2} />
        <line x1={TILE/2} y1="0" x2="0" y2={TILE/2} />
        <line x1={TILE/2} y1="0" x2={TILE} y2={TILE/2} />
        <line x1={TILE} y1="0" x2={TILE/2} y2={TILE/2} />
        <line x1="0" y1={TILE/2} x2={TILE/2} y2={TILE} />
        <line x1={TILE/2} y1={TILE/2} x2="0" y2={TILE} />
        <line x1={TILE/2} y1={TILE/2} x2={TILE} y2={TILE} />
        <line x1={TILE} y1={TILE/2} x2={TILE/2} y2={TILE} />
      </g>
    </pattern>
    <radialGradient id="glow" cx="0.12" cy="0.18" r="0.5">
      <stop offset="0" stop-color="#f56b3d" stop-opacity="0.16" />
      <stop offset="1" stop-color="#f56b3d" stop-opacity="0" />
    </radialGradient>
    <clipPath id="avatarClip">
      <rect
        x={AVATAR_X + RING}
        y={AVATAR_Y + RING}
        width={AVATAR_SIZE - RING * 2}
        height={AVATAR_SIZE - RING * 2}
        rx={AVATAR_RADIUS - 4}
        ry={AVATAR_RADIUS - 4}
      />
    </clipPath>
  </defs>

  <rect width={W} height={H} fill="url(#bg)" />
  <rect width={W} height={H} fill="url(#cobogo)" />
  <rect width={W} height={H} fill="url(#glow)" />

  <rect x="0" y="0" width={W} height={ACCENT_H} fill="#f56b3d" />

  <rect
    x={AVATAR_X}
    y={AVATAR_Y}
    width={AVATAR_SIZE}
    height={AVATAR_SIZE}
    rx={AVATAR_RADIUS}
    ry={AVATAR_RADIUS}
    fill="none"
    stroke="#ede4d3"
    stroke-width={RING}
  />
  <image
    href={`data:image/png;base64,${avatarB64}`}
    x={AVATAR_X + RING}
    y={AVATAR_Y + RING}
    width={AVATAR_SIZE - RING * 2}
    height={AVATAR_SIZE - RING * 2}
    clip-path="url(#avatarClip)"
    preserveAspectRatio="xMidYMid slice"
  />
</svg>
