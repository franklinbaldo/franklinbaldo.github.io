    border-radius: 4px;
    line-height: 1;
  }
  .versus-margin {
    font-family: var(--pico-font-family-monospace);
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--pico-primary);
    margin-top: 0.15rem;
