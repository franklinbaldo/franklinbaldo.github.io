  .versus-medal {
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .versus-divider {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .versus-vs {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--pico-muted-color);
    background: var(--pico-muted-border-color);
