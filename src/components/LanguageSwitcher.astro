---
import { LANGUAGES, DEFAULT_LANG } from '../lib/i18n';

const langLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([code, cfg]) => [code, cfg.ui['lang.label']]),
);
const switchLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([code, cfg]) => [code, cfg.ui['lang.switchLabel']]),
);
const noTransLabels = Object.fromEntries(
  Object.entries(LANGUAGES).map(([code, cfg]) => [code, cfg.ui['lang.noTranslation']]),
);
const supported = Object.keys(LANGUAGES);
const navMatch = Object.fromEntries(
  Object.entries(LANGUAGES).map(([code, cfg]) => [code, cfg.navMatch]),
);
---

<button
  type="button"
  class="contrast outline"
  data-lang-switcher
  aria-label="Switch language"
  hidden
>
  <span data-label>🌐</span>
</button>

<script
  is:inline
  define:vars={{ supported, langLabels, switchLabels, noTransLabels, navMatch, defaultLang: DEFAULT_LANG }}
>
  (() => {
    const btn = document.querySelector('[data-lang-switcher]');
    if (!btn) return;
    const label = btn.querySelector('[data-label]');

    const detect = () => {
      const stored = localStorage.getItem('lang');
      if (stored && supported.includes(stored)) return stored;
      const navLang = (navigator.language || '').toLowerCase();
      for (const code of supported) {
        const prefixes = navMatch[code] || [code];
        if (prefixes.some((p) => navLang.startsWith(p))) return code;
      }
      return defaultLang;
    };

    const userLang = detect();
    if (!localStorage.getItem('lang')) localStorage.setItem('lang', userLang);

    const translations = (window.__translations || {});
    const pageLang = window.__pageLang || document.documentElement.lang || defaultLang;

    // Auto-redirect once if user prefers a different language and a translation exists.
    if (translations[userLang] && pageLang !== userLang) {
      const key = 'visited:' + location.pathname;
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, '1');
        location.href = translations[userLang];
        return;
      }
    }

    // Decide target language: prefer user's stored choice if a translation exists,
    // else first available alternate translation.
    const otherCodes = supported.filter((c) => c !== pageLang);
    const candidate = translations[userLang] ? userLang
      : otherCodes.find((c) => translations[c]);

    // Labels are authored from the current page's perspective: the EN bundle's
    // `lang.label` says "PT" because that's what an EN reader sees on the button.
    // So look up labels by pageLang, not by the target candidate.
    if (candidate) {
      label.textContent = langLabels[pageLang] || pageLang.toUpperCase();
      btn.setAttribute('aria-label', switchLabels[pageLang] || `Switch language`);
      btn.disabled = false;
    } else {
      label.textContent = langLabels[pageLang] || '—';
      btn.setAttribute('aria-label', noTransLabels[pageLang] || 'No translation');
      btn.disabled = true;
    }
    btn.hidden = false;

    btn.addEventListener('click', () => {
      if (!candidate) return;
      const target = translations[candidate];
      if (!target) return;
      localStorage.setItem('lang', candidate);
      location.href = target;
    });
  })();
</script>
