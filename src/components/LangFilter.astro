---

<fieldset role="group" aria-label="Filter posts by language" data-lang-filter>
  <button type="button" data-filter="all" aria-pressed="true">All</button>
  <button type="button" data-filter="en" aria-pressed="false" class="outline">🇺🇸 EN</button>
  <button type="button" data-filter="pt" aria-pressed="false" class="outline">🇧🇷 PT</button>
</fieldset>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-lang-filter]');
    if (!root) return;
    const buttons = root.querySelectorAll('button[data-filter]');

    const apply = (f) => {
      document.querySelectorAll('[data-post-lang]').forEach((el) => {
        el.style.display = f === 'all' || el.dataset.postLang === f ? '' : 'none';
      });
      buttons.forEach((b) => {
        const active = b.dataset.filter === f;
        b.setAttribute('aria-pressed', String(active));
        b.classList.toggle('outline', !active);
      });
    };

    const init = () => {
      const stored = localStorage.getItem('lang');
      if (stored === 'en' || stored === 'pt') apply(stored);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
    document.addEventListener('astro:page-load', init);

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        if (f !== 'all') localStorage.setItem('lang', f);
        else localStorage.removeItem('lang');
        apply(f);
      });
    });
  })();
</script>
