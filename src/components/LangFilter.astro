---

<div class="lang-filter" role="group" aria-label="Filter posts by language" data-lang-filter>
  <button type="button" data-filter="all" aria-pressed="true">All</button>
  <button type="button" data-filter="en" aria-pressed="false">🇺🇸 EN</button>
  <button type="button" data-filter="pt" aria-pressed="false">🇧🇷 PT</button>
</div>

<script is:inline>
  (() => {
    const root = document.querySelector('[data-lang-filter]');
    if (!root) return;
    const buttons = root.querySelectorAll('button[data-filter]');

    const apply = (f) => {
      document.querySelectorAll('[data-post-lang]').forEach((el) => {
        el.style.display = f === 'all' || el.dataset.postLang === f ? '' : 'none';
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
    };

    const stored = localStorage.getItem('lang');
    if (stored === 'en' || stored === 'pt') apply(stored);

    buttons.forEach((b) => {
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        if (f !== 'all') localStorage.setItem('lang', f);
        apply(f);
      });
    });
  })();
</script>

<style>
  .lang-filter {
    display: flex;
    gap: 0.5rem;
  }
  .lang-filter button {
    padding: 0.3rem 0.8rem;
    font-size: 0.82rem;
    margin: 0;
    width: auto;
    border: 1px solid var(--pico-primary);
    background: transparent;
    color: var(--pico-primary);
    cursor: pointer;
    border-radius: var(--pico-border-radius);
  }
  .lang-filter button[aria-pressed="true"] {
    background: var(--pico-primary);
    color: var(--pico-primary-inverse);
  }
</style>
