---
interface Props {
  lang?: 'en' | 'pt';
}

const { lang = 'en' } = Astro.props;
const copy = lang === 'pt'
  ? { tagline: 'Advogado e Procurador do Estado. Escreve sobre agentes de IA, metafísica do processo e design jurídico.', more: 'Mais ensaios →' }
  : { tagline: 'Lawyer and State Attorney. Writes on AI agency, process metaphysics, and legal design.', more: 'More essays →' };
---

<aside>
  <article>
    <header>
      <hgroup>
        <h3>Franklin Baldo</h3>
        <p><small>{lang === 'pt' ? 'Autor' : 'Author'}</small></p>
      </hgroup>
    </header>
    <p>{copy.tagline}</p>
    <footer>
      <a href={lang === 'pt' ? '/pt/' : '/'}>{copy.more}</a>
    </footer>
  </article>
</aside>
