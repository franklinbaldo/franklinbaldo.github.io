---
import { READING_PATHS, getPathPosts } from '../lib/paths';
import { t, pick, urlPrefix, DEFAULT_LANG } from '../lib/i18n';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;

const cards = await Promise.all(
  READING_PATHS.map(async (path) => {
    const posts = await getPathPosts(path.slug, lang ?? DEFAULT_LANG);
    return { path, count: posts.length };
  }),
);

const visible = cards.filter((c) => c.count > 0);
const pathsRoot = `${urlPrefix(lang)}/paths`;

// Thin-line icons that match the cobogó aesthetic. Stroke uses currentColor
// so each icon picks up the card's accent at render time.
const ICONS: Record<string, string> = {
  'agency-and-constraint': `
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="32" cy="32" r="27"/>
      <circle cx="32" cy="32" r="18"/>
      <circle cx="32" cy="32" r="9"/>
      <circle cx="32" cy="32" r="2.2" fill="currentColor"/>
      <line x1="32" y1="2" x2="32" y2="13"/>
      <line x1="32" y1="51" x2="32" y2="62"/>
      <line x1="2" y1="32" x2="13" y2="32"/>
      <line x1="51" y1="32" x2="62" y2="32"/>
    </svg>`,
  'memory-and-funes': `
    <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <circle cx="32" cy="32" r="6"/>
      <circle cx="32" cy="32" r="14"/>
      <circle cx="32" cy="32" r="22"/>
      <circle cx="32" cy="32" r="28"/>
      <line x1="32" y1="32" x2="60" y2="32"/>
      <circle cx="60" cy="32" r="1.6" fill="currentColor"/>
    </svg>`,
};
---

{visible.length > 0 && (
  <section class="paths-teaser" aria-label={t(lang, 'paths.heading')}>
    <p class="paths-eyebrow"><small>{t(lang, 'paths.heading')}</small></p>
    <h2 class="paths-heading">{t(lang, 'paths.heading')}</h2>
    <p class="paths-blurb">{t(lang, 'paths.blurb')}</p>
    <div class="paths-grid">
      {visible.map(({ path, count }) => (
        <article class="path-card">
          <div class="path-icon" set:html={ICONS[path.slug] ?? ''} />
          <div class="path-body">
            <h3>
              <a href={`${pathsRoot}/${path.slug}/`}>{pick(lang, path.title)}</a>
            </h3>
            <p class="path-blurb">{pick(lang, path.blurb)}</p>
            <p class="path-meta">
              <small>
                {count}{' '}{t(lang, count === 1 ? 'paths.essay' : 'paths.essays')}
                {' · '}
                <a href={`${pathsRoot}/${path.slug}/`}>{t(lang, 'paths.startHere')}</a>
              </small>
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .paths-teaser {
    margin-block: calc(var(--pico-spacing) * 2);
  }
  .paths-eyebrow {
    margin: 0 0 .25rem;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pico-primary);
  }
  .paths-heading {
    margin: 0 0 .5rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.15;
  }
  .paths-blurb {
    margin: 0 0 var(--pico-spacing);
    color: var(--pico-muted-color);
    max-width: 50ch;
  }
  .paths-grid {
    display: grid;
    gap: var(--pico-spacing);
    /* min(20rem, 100%) keeps each card from forcing the grid track wider
       than the viewport at <320px screens — the classic "rfs grid" pattern. */
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
  }
  .path-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    border: 1px solid var(--pico-muted-border-color);
    border-top: 2px solid var(--pico-primary);
    background: var(--pico-card-background-color);
    padding: calc(var(--pico-spacing) * 1.25);
  }
  .path-icon {
    width: 64px;
    height: 64px;
    color: var(--pico-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .path-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .path-body {
    min-width: 0;
  }
  .path-card h3 {
    margin: 0 0 .5rem;
    font-size: 1.4rem;
    line-height: 1.2;
  }
  .path-card h3 a {
    text-decoration: none;
    color: inherit;
  }
  .path-card h3 a:hover {
    color: var(--pico-primary);
  }
  .path-blurb {
    margin: 0 0 .75rem;
  }
  .path-meta {
    margin: 0;
    color: var(--pico-muted-color);
  }
  @media (max-width: 480px) {
    .path-card {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 1rem;
    }
    .path-icon {
      width: 48px;
      height: 48px;
    }
  }
</style>
