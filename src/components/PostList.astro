---
import type { CollectionEntry } from 'astro:content';
import PostCard from './PostCard.astro';

interface Props {
  posts: CollectionEntry<'blog'>[];
  label?: string;
}

const { posts, label } = Astro.props;
---

<section aria-label={label ?? 'Posts'}>
  {posts.map((post) => <PostCard post={post} />)}
</section>
