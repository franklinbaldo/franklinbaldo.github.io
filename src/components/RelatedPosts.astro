---
import { getCollection } from 'astro:content';
import { t, DEFAULT_LANG } from '../lib/i18n';

interface Props {
  currentId: string;
  tags: string[];
  lang?: string;
}

const { currentId, tags, lang } = Astro.props;
const currentLang = lang ?? DEFAULT_LANG;

const related = tags.length === 0 ? [] : (await getCollection('blog'))
  .filter(p => !p.data.draft && p.id !== currentId && (p.data.lang ?? DEFAULT_LANG) === currentLang)
  .map(p => ({
    post: p,
    shared: (p.data.tags ?? []).filter(t => tags.includes(t)).length,
  }))
  .filter(({ shared }) => shared > 0)
  .sort((a, b) => b.shared - a.shared || b.post.data.date.valueOf() - a.post.data.date.valueOf())
  .slice(0, 3)
  .map(({ post }) => post);

const heading = t(lang, 'related.heading');
const headingId = 'related-posts-heading';
---

{related.length > 0 && (
  <section aria-labelledby={headingId}>
    <h3 id={headingId}>{heading}</h3>
    {related.map(p => (
      <article>
        <h4><a href={`/blog/${p.id}/`}>{p.data.title}</a></h4>
        {p.data.description && <p><small>{p.data.description}</small></p>}
      </article>
    ))}
  </section>
)}
