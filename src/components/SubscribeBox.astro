---
interface Props {
  lang?: 'en' | 'pt';
  username?: string;
}

const { lang = 'en', username = 'franklinbaldo' } = Astro.props;

const copy = lang === 'pt'
  ? {
      title: 'Receba os ensaios por email',
      subtitle: 'Sobre agentes de IA, metafísica do processo e design jurídico. Sem spam.',
      label: 'Email',
      placeholder: 'seu@email.com',
      button: 'Inscrever',
      rss: 'Prefiro RSS',
    }
  : {
      title: 'Subscribe',
      subtitle: 'Essays on AI agency, process metaphysics, and legal design. No spam, unsubscribe anytime.',
      label: 'Email',
      placeholder: 'you@email.com',
      button: 'Subscribe',
      rss: 'I prefer RSS',
    };
---

<aside id="subscribe">
  <article>
    <hgroup>
      <h3>{copy.title}</h3>
      <p>{copy.subtitle}</p>
    </hgroup>
    <form
      action={`https://buttondown.email/api/emails/embed-subscribe/${username}`}
      method="post"
      target="popupwindow"
    >
      <label>
        {copy.label}
        <input type="email" name="email" placeholder={copy.placeholder} required />
      </label>
      <button type="submit">{copy.button}</button>
    </form>
    <footer>
      <small><a href="/rss.xml">{copy.rss}</a></small>
    </footer>
  </article>
</aside>
