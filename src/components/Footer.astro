---
import { t, urlPrefix } from '../lib/i18n';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const year = new Date().getFullYear();
const prefix = urlPrefix(lang);

// Same grouping/order as Header.astro's primaryLinks + secondaryLinks
// (essays/projects/about/search, then music/books/audiobooks/ranking/tags/changelog)
// so the header and footer agree on how the site's sections are organized
// — they used to both be one flat list; keep them in sync now that the
// header groups the second half under "More".
const footerNav = [
  { href: `${prefix}/archive/`, label: t(lang, 'nav.archive') },
  { href: `${prefix}/projects/`, label: t(lang, 'nav.projects') },
  { href: `${prefix}/about/`, label: t(lang, 'nav.about') },
  { href: `${prefix}/search/`, label: t(lang, 'nav.search') },
  { href: lang === 'pt' ? `${prefix}/musicas/` : '/music/', label: t(lang, 'nav.music') },
  { href: lang === 'pt' ? `${prefix}/livros/` : '/books/', label: t(lang, 'nav.books') },
  { href: '/audiobooks/', label: lang === 'pt' ? 'Audiolivros' : 'Audiobooks' },
  { href: `${prefix}/ranking/`, label: t(lang, 'nav.ranking') },
  { href: `${prefix}/tags/`, label: t(lang, 'nav.tags') },
  // English-only by deliberate exception (CLAUDE.md "Línguas") — no /pt/ prefix.
  { href: '/changelog/', label: 'Changelog' },
];
---

<footer class="container site-footer">
  <nav class="footer-nav">
    <ul>
      <li><small>© {year} Franklin Baldo</small></li>
    </ul>
    <ul class="footer-links">
      {footerNav.map((l) => (
        <li><small><a href={l.href} class="secondary">{l.label}</a></small></li>
      ))}
    </ul>
    <ul>
      <li><small><a href="/rss.xml" aria-label="RSS feed (English)">RSS EN</a></small></li>
      <li><small><a href="/pt/rss.xml" aria-label="Feed RSS (Português)">RSS PT</a></small></li>
      <li><small><a href="https://github.com/franklinbaldo" rel="me">GitHub</a></small></li>
      <li id="footer-lang-li" style="display:none">
        <small><a id="footer-lang-link" href="#" class="secondary"></a></small>
      </li>
    </ul>
  </nav>
</footer>
<script is:inline>
  (() => {
    const translations = window.__translations || {};
    const pageLang = window.__pageLang || document.documentElement.lang || "en";
    const target = Object.keys(translations).find((k) => k !== pageLang);
    const li = document.getElementById("footer-lang-li");
    const link = document.getElementById("footer-lang-link");
    if (!li || !link || !target) return;
    link.href = translations[target];
    link.textContent = target === "pt" ? "Português" : "English";
    link.setAttribute(
      "aria-label",
      target === "pt" ? "Ver em Português" : "View in English"
    );
    link.onclick = () => localStorage.setItem("lang", target);
    li.style.display = "";
  })();
</script>

<style>
  .site-footer {
    margin-top: calc(var(--pico-spacing) * 2);
    padding-block: calc(var(--pico-spacing) * 1.25);
    border-top: 1px solid var(--pico-muted-border-color);
    color: var(--pico-muted-color);
  }
  .site-footer a {
    text-decoration: none;
  }
  .site-footer a:hover {
    color: var(--pico-primary);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  @media (max-width: 768px) {
    .footer-nav {
      flex-direction: column;
      gap: 0.5rem;
    }
    .footer-links {
      flex-wrap: wrap;
    }
  }
</style>
