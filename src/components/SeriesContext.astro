---
import type { SeriesContext } from '../lib/series';
import { t } from '../lib/i18n';

interface Props {
  series: SeriesContext;
  lang?: string;
  variant?: 'aside' | 'nav';
}

const { series, lang, variant = 'aside' } = Astro.props;
---

{variant === 'aside' && (
  <aside class="series-context">
    <small>
      {t(lang, 'post.partOf')} {series.index + 1} {t(lang, 'post.of')} {series.posts.length}
      {' — '}<strong>{series.slug}</strong>.
    </small>
    <details>
      <summary>{t(lang, 'post.allInSeries')}</summary>
      <ol>
        {series.posts.map((p, i) => (
          <li>
            {i === series.index
              ? <><strong>{p.data.title}</strong> <em>({t(lang, 'post.thisPost')})</em></>
              : <a href={p.data.lang === 'pt' ? `/pt/blog/${p.data.slug ?? p.id}/` : `/blog/${p.data.slug ?? p.id}/`}>{p.data.title}</a>}
          </li>
        ))}
      </ol>
    </details>
  </aside>
)}

{variant === 'nav' && (series.prev || series.next) && (
  <nav aria-label={t(lang, 'series.navLabel')} class="series-nav">
    <ul>
      {series.prev && (
        <li><a href={series.prev.data.lang === 'pt' ? `/pt/blog/${series.prev.data.slug ?? series.prev.id}/` : `/blog/${series.prev.data.slug ?? series.prev.id}/`} rel="prev">← {series.prev.data.title}</a></li>
      )}
      {series.next && (
        <li><a href={series.next.data.lang === 'pt' ? `/pt/blog/${series.next.data.slug ?? series.next.id}/` : `/blog/${series.next.data.slug ?? series.next.id}/`} rel="next">{series.next.data.title} →</a></li>
      )}
    </ul>
  </nav>
)}
