---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { t, urlPrefix } from '../lib/i18n';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;

const prefix = urlPrefix(lang);
const homeHref = `${prefix}/`;
const archiveHref = `${prefix}/archive/`;
const tagsHref = `${prefix}/tags/`;
const musicHref = lang === 'pt' ? `${prefix}/musicas/` : '/music/';
const booksHref = lang === 'pt' ? `${prefix}/livros/` : '/books/';
const searchHref = `${prefix}/search/`;
const projectsHref = `${prefix}/projects/`;
const rankingHref = `${prefix}/ranking/`;
const aboutHref = `${prefix}/about/`;
// Changelog content is English-only by deliberate exception (CLAUDE.md
// "Línguas") — one page serves both languages, no /pt/ prefix.
const changelogHref = '/changelog/';

const menuLabel = t(lang, 'nav.menu');
const moreLabel = t(lang, 'nav.more');
const collectionLabel = t(lang, 'nav.collections');
const playMusicLabel = t(lang, 'nav.playMusic');
const pauseMusicLabel = t(lang, 'nav.pauseMusic');

// Label kept as t(lang, 'nav.archive') ("Archive"/"Arquivo"), not a rebrand
// like "Essays" — the /archive/ page's own <h1> and the breadcrumb on every
// post (src/pages/[pt/]blog/[...slug].astro) both still say "Archive", and
// a nav label that disagrees with the page it links to reads as a broken
// link. Rename all three together in one PR if the "Essays" language is
// wanted.
const primaryLinks = [
  { href: archiveHref, label: t(lang, 'nav.archive') },
  { href: projectsHref, label: t(lang, 'nav.projects') },
  { href: aboutHref, label: t(lang, 'nav.about') },
  { href: searchHref, label: t(lang, 'nav.search') },
];

const secondaryLinks = [
  { href: musicHref, label: t(lang, 'nav.music') },
  { href: booksHref, label: t(lang, 'nav.books') },
  { href: rankingHref, label: t(lang, 'nav.ranking') },
  { href: tagsHref, label: t(lang, 'nav.tags') },
  { href: changelogHref, label: 'Changelog' },
];

const here = Astro.url.pathname.replace(/\/$/, '') + '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/$/, '') + '/';
  if (h === '/' || h === `${prefix}/`) return here === h;
  return here === h;
};
const secondaryCurrent = secondaryLinks.some((link) => isCurrent(link.href));
---

<header class="site-header">
  <nav
    class="container"
    aria-label={lang === 'pt' ? 'Navegação principal' : 'Main navigation'}
  >
    <ul>
      <li>
        <a
          href={homeHref}
          class="brand contrast"
          aria-current={here === homeHref ? 'page' : undefined}
        >
          Franklin Baldo<span class="brand-dot" aria-hidden="true">.</span>
        </a>
      </li>
    </ul>
    <ul class="nav-inline">
      {
        primaryLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="secondary"
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              data-search-link={link.href === searchHref ? true : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <details class="dropdown more-menu">
          <summary
            class="secondary"
            aria-current={secondaryCurrent ? 'page' : undefined}
          >
            {moreLabel}
          </summary>
          <ul>
            <li class="menu-section">{collectionLabel}</li>
            {
              secondaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
      <li>
        <button
          id="nav-music-btn"
          class="nav-music-btn secondary outline"
          type="button"
          aria-label={playMusicLabel}
          title={playMusicLabel}
          data-play-label={playMusicLabel}
          data-pause-label={pauseMusicLabel}
        >♪</button>
      </li>
      <li><LanguageSwitcher /></li>
      <li><ThemeToggle lang={lang} /></li>
    </ul>
    <ul class="nav-burger">
      <li>
        <button
          id="nav-music-btn-mobile"
          class="nav-music-btn secondary outline"
          type="button"
          aria-label={playMusicLabel}
          title={playMusicLabel}
          data-play-label={playMusicLabel}
          data-pause-label={pauseMusicLabel}
        >♪</button>
      </li>
      <li><LanguageSwitcher /></li>
      <li><ThemeToggle lang={lang} /></li>
      <li>
        <details class="dropdown burger-menu">
          <summary aria-label={menuLabel}>☰</summary>
          <ul>
            {
              primaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    data-search-link={link.href === searchHref ? true : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li class="menu-section">{collectionLabel}</li>
            {
              secondaryLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</header>

<script>
  function syncMusicBtn(audio: HTMLAudioElement | null) {
    const btns = document.querySelectorAll<HTMLButtonElement>('.nav-music-btn');
    btns.forEach((btn) => {
      if (!audio || audio.paused) {
        btn.textContent = '♪';
        btn.setAttribute('aria-label', btn.dataset.playLabel || 'Play music');
        btn.classList.remove('playing');
      } else {
        btn.textContent = '⏸';
        btn.setAttribute('aria-label', btn.dataset.pauseLabel || 'Pause music');
        btn.classList.add('playing');
      }
    });
  }

  function initMusicBtn() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.nav-music-btn');
    if (!btns.length) return;

    const audio = document.getElementById('gmp-audio') as HTMLAudioElement | null;

    // Sync initial state
    syncMusicBtn(audio);

    if (audio && audio.dataset.navBound !== '1') {
      audio.dataset.navBound = '1';
      audio.addEventListener('play', () => syncMusicBtn(audio));
      audio.addEventListener('pause', () => syncMusicBtn(audio));
      audio.addEventListener('ended', () => syncMusicBtn(audio));
    }

    btns.forEach((btn) => {
      if (btn.dataset.musicBound === '1') return;
      btn.dataset.musicBound = '1';
      btn.addEventListener('click', () => {
        const a = document.getElementById('gmp-audio') as HTMLAudioElement | null;
        const player = document.getElementById('gmp') as HTMLElement | null;

        if (a && !a.paused) {
          // Playing → pause
          a.pause();
        } else if (a && a.src && player && !player.hidden) {
          // Paused but has a track → resume
          a.play().catch(() => {});
        } else {
          // Nothing playing → start first song from player's queue
          const gmp = document.getElementById('gmp') as HTMLElement | null;
          let songs: { id: string; title: string }[] = [];
          try {
            songs = JSON.parse(gmp?.dataset.songs || '[]');
          } catch {}
          if (songs[0]) {
            document.dispatchEvent(
              new CustomEvent('gp:play', {
                detail: { sunoId: songs[0].id, title: songs[0].title },
              }),
            );
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMusicBtn);
  } else {
    initMusicBtn();
  }
  document.addEventListener('astro:page-load', initMusicBtn);

  function isTypingTarget(el: Element | null): boolean {
    if (!el) return false;
    const tag = el.tagName;
    return (
      tag === 'INPUT' ||
      tag === 'TEXTAREA' ||
      tag === 'SELECT' ||
      (el as HTMLElement).isContentEditable
    );
  }

  function focusSearch(event: KeyboardEvent) {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    if (isTypingTarget(document.activeElement)) return;

    const searchbox = document.querySelector('pagefind-searchbox');
    const searchInput = searchbox?.querySelector<HTMLInputElement>('input');
    if (searchInput) {
      event.preventDefault();
      searchInput.focus();
      return;
    }

    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('[data-search-link]'),
    );
    const link = links.find((el) => el.offsetParent !== null) ?? links[0];
    if (link) {
      event.preventDefault();
      link.focus();
    }
  }

  const win = window as unknown as {
    __searchShortcutBound?: boolean;
    __dropdownEscBound?: boolean;
  };
  if (!win.__searchShortcutBound) {
    win.__searchShortcutBound = true;
    document.addEventListener('keydown', focusSearch);
  }

  function closeOpenDropdowns(event: KeyboardEvent) {
    if (event.key !== 'Escape') return;
    const openDropdowns = document.querySelectorAll<HTMLDetailsElement>('details.dropdown[open]');
    openDropdowns.forEach((details) => {
      details.removeAttribute('open');
      details.querySelector('summary')?.focus();
    });
  }

  if (!win.__dropdownEscBound) {
    win.__dropdownEscBound = true;
    document.addEventListener('keydown', closeOpenDropdowns);
  }
</script>

<style>
  /*
   * Sticky paper masthead. With the secondary collection links grouped under
   * More, the primary navigation can remain visible on laptop widths instead
   * of collapsing almost everywhere.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: 0;
    --pico-nav-element-spacing-vertical: 0.5rem;
    background: var(--pico-background-color);
    border-bottom: 1px solid var(--pico-muted-border-color);
  }
  .site-header > nav {
    padding-block: 0.25rem;
  }

  .brand {
    font-family: var(--pico-font-family-serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    overflow-wrap: normal;
  }
  .brand:hover {
    color: var(--pico-primary);
  }
  .brand-dot {
    color: var(--pico-primary);
  }

  .nav-inline a,
  .nav-inline summary {
    font-size: 0.92rem;
    text-decoration: none;
    overflow-wrap: normal;
    word-break: normal;
    white-space: nowrap;
  }
  .nav-inline a[aria-current='page'],
  .nav-inline summary[aria-current='page'] {
    color: var(--pico-primary);
    text-decoration: underline;
    text-underline-offset: 0.45em;
    text-decoration-thickness: 2px;
  }

  .more-menu > summary {
    padding-inline: 0.5rem;
    cursor: pointer;
  }
  .more-menu > ul {
    right: 0;
    left: auto;
    min-width: 13rem;
  }
  .menu-section {
    padding: 0.45rem 0.75rem 0.25rem;
    color: var(--pico-muted-color);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .nav-burger {
    display: none;
  }
  /* Unverified: this replaced a previous 1279px cutoff that had a specific
     measured justification (Pico's own .container breakpoint, plus a
     measured ~960px width need for the old 8-link flat nav — see git
     history). This value has not been re-measured against the current
     content (4 primaryLinks + the "More" summary + music button + language
     switcher + theme toggle, longest in pt: "Ensaios"/"Projetos"/"Sobre"/
     "Buscar"/"Mais"). Check in a real browser between ~899px and ~1280px
     before trusting this, especially in pt. */
  @media (max-width: 899px) {
    .nav-inline {
      display: none;
    }
    .nav-burger {
      display: flex;
    }
  }
  .burger-menu > summary {
    padding-inline: 0.5rem;
  }
  .burger-menu > ul {
    right: 0;
    left: auto;
    min-width: 13rem;
  }
  .burger-menu .menu-section {
    border-top: 1px solid var(--pico-muted-border-color);
    margin-top: 0.25rem;
  }

  .nav-music-btn {
    padding: 0.25rem 0.6rem;
    font-size: 1rem;
    line-height: 1;
    border-radius: 6px;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
    white-space: nowrap;
  }
  .nav-music-btn.playing {
    background: var(--pico-primary) !important;
    color: var(--pico-primary-inverse, #fff) !important;
    border-color: var(--pico-primary) !important;
  }
</style>
