---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang?: 'en' | 'pt';
}
const { lang = 'en' } = Astro.props;

const isPt = lang === 'pt';
const homeHref    = isPt ? '/pt/'         : '/';
const archiveHref = isPt ? '/pt/archive/' : '/archive/';
const tagsHref    = isPt ? '/pt/tags/'    : '/tags/';
const searchHref  = isPt ? '/pt/search/'  : '/search/';
const aboutHref   = isPt ? '/pt/about/'   : '/about/';

const labels = isPt
  ? { archive: 'Arquivo', tags: 'Tags', projects: 'Projetos', search: 'Busca', about: 'Sobre', menu: 'Menu' }
  : { archive: 'Archive', tags: 'Tags', projects: 'Projects', search: 'Search', about: 'About', menu: 'Menu' };

const navLinks = [
  { href: archiveHref,  label: labels.archive },
  { href: tagsHref,     label: labels.tags },
  { href: '/projects/', label: labels.projects },
  { href: searchHref,   label: labels.search },
  { href: aboutHref,    label: labels.about },
];
---

<header class="container">
  <nav>
    <ul>
      <li><strong><a href={homeHref} class="contrast">Franklin Baldo</a></strong></li>
    </ul>
    <ul class="nav-inline">
      {navLinks.map((l) => (
        <li><a href={l.href} class="secondary">{l.label}</a></li>
      ))}
      <li><LanguageSwitcher /></li>
      <li><ThemeToggle /></li>
    </ul>
    <ul class="nav-burger">
      <li><LanguageSwitcher /></li>
      <li><ThemeToggle /></li>
      <li>
        <details class="menu">
          <summary aria-label={labels.menu}>☰</summary>
          <ul>
            {navLinks.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav-burger { display: none; }
  @media (max-width: 768px) {
    .nav-inline { display: none; }
    .nav-burger { display: flex; }
  }
  .menu { position: relative; }
  .menu > summary { list-style: none; cursor: pointer; padding: 0.25rem 0.5rem; }
  .menu > summary::-webkit-details-marker { display: none; }
  .menu[open] > ul {
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 10;
    background: var(--pico-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: var(--pico-border-radius);
    padding: 0.5rem;
    list-style: none;
    min-width: 12rem;
    margin: 0.25rem 0 0;
  }
  .menu[open] > ul > li {
    padding: 0;
  }
  .menu[open] > ul > li > a {
    display: block;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
    border-radius: calc(var(--pico-border-radius) / 2);
  }
  .menu[open] > ul > li > a:hover {
    background: var(--pico-primary-background);
    color: var(--pico-primary-inverse);
  }
</style>
