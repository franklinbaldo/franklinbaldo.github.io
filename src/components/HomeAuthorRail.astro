---
import { Image } from 'astro:assets';
import { t, urlPrefix } from '../lib/i18n';
import avatarImage from '../assets/images/avatar.png';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const homeSearch = `${urlPrefix(lang)}/search/`;
---

<aside class="home-author-rail" aria-label={t(lang, 'author.aboutEyebrow')}>
  <div class="rail-avatar" data-tooltip="Franklin Baldo" data-placement="bottom">
    <Image 
      src={avatarImage} 
      alt="Franklin Baldo" 
      width={96} 
      height={96} 
      loading="lazy" 
      decoding="async" 
    />
  </div>

  <p class="rail-eyebrow"><small>{t(lang, 'author.aboutEyebrow')}</small></p>
  <p class="rail-bio">{t(lang, 'author.tagline')}</p>
  <p class="rail-more">
    <a href={`${urlPrefix(lang)}/about/`}>{t(lang, 'author.moreAbout')}</a>
    <span>•</span>
    <a href={homeSearch}>{t(lang, 'nav.search')}</a>
  </p>
</aside>

<style>
  .home-author-rail {
    text-align: center;
    padding: 1.5rem 1rem;
    background: var(--pico-card-background-color);
    border-radius: var(--pico-border-radius);
    border: 1px solid var(--pico-muted-border-color);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    position: sticky;
    top: 5.5rem;
  }
  .rail-avatar {
    margin-bottom: 0.5rem;
  }
  .rail-avatar img {
    border-radius: 50%;
    width: 96px;
    height: 96px;
    object-fit: cover;
    border: 2px solid var(--pico-primary);
    background: var(--pico-background-color);
  }
  .rail-eyebrow {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pico-muted-color);
  }
  .rail-bio {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--pico-color);
  }
  .rail-more {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    display: flex;
    gap: 0.5rem;
    color: var(--pico-muted-color);
  }
  .rail-more a {
    text-decoration: none;
    font-weight: 500;
  }
</style>
