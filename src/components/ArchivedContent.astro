---
// RFC 0010 perf: archived version pages (/blog/<slug>/v/<uuid>) don't run
// the MDX/remark/rehype/Shiki pipeline at build time — there are hundreds
// of superseded drafts and they're noindex, low-traffic archival pages.
// Instead this ships a placeholder and fetches the raw markdown straight
// from GitHub client-side, rendering it in the browser with `marked`.
// Math (KaTeX) and code highlighting (highlight.js) are loaded lazily, only
// when the fetched content actually needs them, to keep the common case
// (plain prose, no math, no code) cheap. Mermaid diagrams reuse the site's
// existing MermaidEnhancer via a custom event, since that page always
// includes it. Greentext gets the same DOM shape (`.line`/`.gt-quote`) the
// live Shiki transformer produces, so the existing CSS in global.css applies
// unchanged. Output is sanitized with DOMPurify before insertion, since this
// content is fetched live from `main` at view time rather than fixed at
// build time like every other rendering path on the site.
interface Props {
  rawUrl: string | null;
  githubUrl: string;
  lang?: string;
}
const { rawUrl, githubUrl, lang } = Astro.props;
const isPt = lang === "pt";
---

<div
  class="archived-content"
  data-raw-url={rawUrl}
  data-github-url={githubUrl}
  data-lang={lang ?? "en"}
>
  <p><em>{isPt ? "Carregando conteúdo arquivado…" : "Loading archived content…"}</em></p>
</div>

<script>
  import DOMPurify from "dompurify";
  import { Marked } from "marked";

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  // Mirrors astro.config.mjs's greentext handling: Shiki has no grammar for
  // it either, so the live pipeline just wraps each line in a `.line` span
  // and flags `>`-prefixed lines as `.gt-quote` — global.css keys off that
  // exact shape (`pre[data-language="greentext"] .line.gt-quote`).
  function renderGreentext(text: string) {
    const lines = text
      .split("\n")
      .map((line) => {
        const cls = /^\s*>/.test(line) ? "line gt-quote" : "line";
        return `<span class="${cls}">${escapeHtml(line)}</span>`;
      })
      .join("\n");
    return `<pre data-language="greentext"><code>${lines}</code></pre>\n`;
  }

  // Matches the DOM shape MermaidEnhancer.astro's selector expects
  // (`article pre[data-language='mermaid']`) so the site's existing mermaid
  // rendering picks these blocks up via the custom event dispatched below.
  function renderMermaid(text: string) {
    return `<pre data-language="mermaid"><code class="language-mermaid">${escapeHtml(text)}</code></pre>\n`;
  }

  const marked = new Marked({
    renderer: {
      code({ text, lang }: { text: string; lang?: string }) {
        const language = (lang || "").trim().split(/\s+/)[0];
        if (language === "greentext") return renderGreentext(text);
        if (language === "mermaid") return renderMermaid(text);
        const cls = language ? ` class="language-${escapeHtml(language)}"` : "";
        return `<pre><code${cls}>${escapeHtml(text)}</code></pre>\n`;
      },
      image({ href, title, text }: { href: string; title?: string | null; text: string }) {
        const titleAttr = title ? ` title="${escapeHtml(title)}"` : "";
        return `<img src="${escapeHtml(href)}" alt="${escapeHtml(text)}" loading="lazy"${titleAttr}>`;
      },
    },
  });

  async function highlightCode(container: HTMLElement) {
    const blocks = container.querySelectorAll<HTMLElement>(
      "pre > code[class*='language-']:not(.language-mermaid)"
    );
    if (blocks.length === 0) return;
    if (!document.querySelector("link[data-hljs-css]")) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/hljs/github-dark.css";
      link.dataset.hljsCss = "true";
      document.head.appendChild(link);
    }
    const { default: hljs } = await import("highlight.js/lib/common");
    blocks.forEach((block) => hljs.highlightElement(block));
  }

  async function renderMath(container: HTMLElement, raw: string) {
    if (!raw.includes("$")) return;
    if (!document.querySelector('link[data-katex-css]')) {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = "/katex/katex.min.css";
      link.dataset.katexCss = "true";
      document.head.appendChild(link);
    }
    const [{ default: renderMathInElement }] = await Promise.all([
      import("katex/contrib/auto-render"),
    ]);
    renderMathInElement(container, {
      delimiters: [
        { left: "$$", right: "$$", display: true },
        { left: "$", right: "$", display: false },
      ],
      throwOnError: false,
    });
  }

  function notifyMermaid() {
    document.dispatchEvent(new CustomEvent("archived-content:loaded"));
  }

  async function loadArchivedContent(container: HTMLElement) {
    const rawUrl = container.dataset.rawUrl;
    const githubUrl = container.dataset.githubUrl || "";
    const isPt = container.dataset.lang === "pt";
    if (!rawUrl) {
      renderFallback(container, githubUrl, isPt);
      return;
    }
    try {
      const res = await fetch(rawUrl);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const raw = (await res.text()).replace(/\r\n/g, "\n");
      const body = raw.replace(/^---\n[\s\S]*?\n---\n?/, "");
      const html = await marked.parse(body);
      container.innerHTML = DOMPurify.sanitize(html, { ADD_ATTR: ["data-language"] });
      await Promise.all([highlightCode(container), renderMath(container, body)]);
      notifyMermaid();
    } catch {
      renderFallback(container, githubUrl, isPt);
    }
  }

  function renderFallback(container: HTMLElement, githubUrl: string, isPt: boolean) {
    const fallback = isPt
      ? `Não foi possível carregar o conteúdo arquivado agora. <a href="${githubUrl}">Ver no GitHub</a>.`
      : `Couldn't load the archived content right now. <a href="${githubUrl}">View on GitHub</a>.`;
    container.innerHTML = `<p><em>${fallback}</em></p>`;
  }

  document
    .querySelectorAll<HTMLElement>(".archived-content")
    .forEach(loadArchivedContent);
</script>

<style>
  .archived-content :global(pre) {
    overflow-x: auto;
  }
</style>
