---
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout
  title="Busca | Franklin Baldo"
  description="Busca de texto completo pelos ensaios."
  lang="pt"
  translations={{ en: "/search/" }}
>
  <hgroup>
    <h1>Busca</h1>
    <p><small>Busca de texto completo por todos os ensaios. Índice construído com <a href="https://pagefind.app/">Pagefind</a>.</small></p>
  </hgroup>

  <fieldset role="search" class="search-fieldset">
    <pagefind-searchbox data-filter="lang:pt"></pagefind-searchbox>
  </fieldset>

  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
  <script is:inline>
    (() => {
      const q = new URLSearchParams(location.search).get('q');
      if (!q) return;
      const tryInit = () => {
        const box = document.querySelector('pagefind-searchbox');
        if (!box) { setTimeout(tryInit, 80); return; }
        box.setAttribute('query', q);
        const ev = new CustomEvent('pagefind:init', { detail: { query: q } });
        box.dispatchEvent(ev);
      };
      document.addEventListener('DOMContentLoaded', tryInit);
    })();
  </script>
</PageLayout>
