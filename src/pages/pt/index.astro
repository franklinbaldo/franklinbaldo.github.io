---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import RecentList from "../../components/RecentList.astro";
import PathsTeaser from "../../components/PathsTeaser.astro";
import HomeAuthorRail from "../../components/HomeAuthorRail.astro";
import { isPublished } from "../../lib/publish";

const all = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .filter((post) => post.data.lang === 'pt')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recent = all.slice(0, 12);
const latest = all[0];
const latestHref = latest ? `/pt/blog/${latest.id}/` : "/pt/archive/";
---

<PageLayout
  title="Franklin Baldo — Notas sobre IA, direito e sistemas."
  description="Ensaios sobre agentes de IA, metafísica do processo e design jurídico por Franklin Baldo, Procurador do Estado em Rondônia."
  lang="pt"
  translations={{ en: "/" }}
>
  <div class="home-layout">
    <div class="home-main">
      <section class="home-hero" aria-label="Introdução">
        <h1 class="home-title">Franklin Baldo</h1>
        <p class="home-tagline">Notas sobre IA, direito e sistemas.</p>
        <p class="home-cta">
          <a href={latestHref} class="contrast">Ler último ensaio →</a>
        </p>
      </section>

      <section class="home-recent" aria-label="Posts recentes">
        <RecentList posts={recent} lang="pt" />
        <p class="home-archive-link">
          <small><a href="/pt/archive/">Ver o arquivo completo →</a></small>
        </p>
      </section>

      <PathsTeaser lang="pt" />
    </div>

    <aside class="home-rail" aria-label="Sobre o autor">
      <HomeAuthorRail lang="pt" />
    </aside>
  </div>
</PageLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 1100px) {
    .home-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
      align-items: start;
    }

    .home-rail {
      position: sticky;
      top: 4.5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  @media (max-width: 1099px) {
    .home-rail {
      border-top: 1px solid var(--pico-border-color);
      padding-top: var(--pico-spacing);
    }
  }

  .home-hero {
    margin-block: calc(var(--pico-spacing) * 1.25) calc(var(--pico-spacing) * 1.5);
  }
  .home-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 .25rem;
    letter-spacing: -0.01em;
  }
  .home-tagline {
    color: var(--pico-muted-color);
    margin: 0;
    font-size: 1rem;
  }
  .home-recent {
    margin-block: calc(var(--pico-spacing) * 1.5) calc(var(--pico-spacing) * 2);
  }
  .home-cta {
    margin: calc(var(--pico-spacing) * 0.75) 0 0;
  }
  .home-cta a {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .home-archive-link {
    margin-top: var(--pico-spacing);
  }
</style>
