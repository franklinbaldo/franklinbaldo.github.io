---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";
import PostCard from "../../../components/PostCard.astro";

export async function getStaticPaths() {
  const all = (await getCollection("blog")).filter((p) => !p.data.draft);
  const ptPosts = all.filter((p) => p.data.lang === 'pt');
  const enTags = new Set<string>();
  for (const post of all.filter((p) => (p.data.lang ?? 'en') === 'en')) {
    for (const tag of post.data.tags ?? []) enTags.add(tag);
  }
  const byTag = new Map<string, CollectionEntry<"blog">[]>();
  for (const post of ptPosts) {
    for (const tag of post.data.tags ?? []) {
      if (!byTag.has(tag)) byTag.set(tag, []);
      byTag.get(tag)!.push(post);
    }
  }
  return [...byTag.entries()].map(([tag, posts]) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      hasEnCounterpart: enTags.has(tag),
    },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<"blog">[];
  hasEnCounterpart: boolean;
}

const { tag, posts, hasEnCounterpart } = Astro.props;
---

<PageLayout
  title={`#${tag} | Franklin Baldo`}
  description={`Ensaios com a etiqueta #${tag}.`}
  lang="pt"
  translations={hasEnCounterpart ? { en: `/tags/${tag}/` } : {}}
>
  <article>
    <header>
      <hgroup>
        <h1>#{tag}</h1>
        <p><small>
          {posts.length} {posts.length === 1 ? "post" : "posts"} · <a href="/pt/tags/">todas as etiquetas</a>
          {hasEnCounterpart && (<> · <a href={`/tags/${tag}/`}>🇺🇸 EN</a></>)}
        </small></p>
      </hgroup>
    </header>
    {posts.map((post) => <PostCard post={post} />)}
  </article>
</PageLayout>
