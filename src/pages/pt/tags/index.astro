---
import { getCollection } from "astro:content";
import PageLayout from "../../../layouts/PageLayout.astro";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .filter((p) => p.data.lang === 'pt');

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags ?? []) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<PageLayout
  title="Etiquetas | Franklin Baldo"
  description="Navegue pelos ensaios por etiqueta."
  lang="pt"
  translations={{ en: "/tags/" }}
>
  <h1>Etiquetas</h1>
  <nav aria-label="Todas as etiquetas">
    <ul>
      {tags.map(([tag, count]) => (
        <li><a href={`/pt/tags/${tag}/`}>#{tag}</a> <small>({count})</small></li>
      ))}
    </ul>
  </nav>
</PageLayout>
