---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "../../../../../layouts/PageLayout.astro";
import VersionBanner from "../../../../../components/VersionBanner.astro";
import ArchivedContent from "../../../../../components/ArchivedContent.astro";
import BackToTop from "../../../../../components/BackToTop.astro";
import {
  uuidForId,
  legacyUuidForId,
  slugOf,
  rawContentUrl,
  githubBlobUrl,
} from "../../../../../lib/versions.mjs";

// RFC 0010: PT mirror of the version route. Every PT non-selected version
// gets /pt/blog/<slug>/v/<uuid>; the selected PT version's UUID redirects to
// /pt/blog/<slug>. For non-selected versions, the legacy body-only UUID also
// renders the archived content (not a redirect — only selected/pruned versions
// redirect). noindex with canonical → the live PT post.
export async function getStaticPaths() {
  const [versions, canon] = await Promise.all([
    getCollection("blogVersions"),
    getCollection("blog"),
  ]);
  const paths: Array<{
    params: { slug: string; uuid: string };
    props: { entry: CollectionEntry<"blogVersions"> | CollectionEntry<"blog">; redirect: boolean };
  }> = [];
  const seen = new Set<string>();
  const push = (slug: string, uuid: string | null | undefined, props: { entry: CollectionEntry<"blogVersions"> | CollectionEntry<"blog">; redirect: boolean }) => {
    const k = `${slug}/${uuid}`;
    if (!uuid || seen.has(k)) return;
    seen.add(k);
    paths.push({ params: { slug, uuid }, props });
  };
  for (const v of versions) {
    if (v.data.lang !== "pt") continue;
    const slug = slugOf(v.id);
    const uuid = uuidForId(v.id);
    if (!uuid) continue; // file gone / unresolved → skip rather than crash
    push(slug, uuid, { entry: v, redirect: false });
    const legacy = legacyUuidForId(v.id);
    if (legacy && legacy !== uuid) {
      push(slug, legacy, { entry: v, redirect: false });
    }
  }
  for (const c of canon) {
    if (c.data.lang !== "pt") continue;
    // Every selected version keeps its /v/<uuid> permalink as a redirect:
    // any peer may have served an archived page under these UUIDs before
    // winning selection, and selection swaps must not 404 old links.
    push(c.id, uuidForId(c.id), { entry: c, redirect: true });
    push(c.id, legacyUuidForId(c.id), { entry: c, redirect: true });
  }
  return paths;
}

type Props = { entry: CollectionEntry<"blogVersions">; redirect: boolean };
const { entry, redirect } = Astro.props;
const slug = slugOf(entry.id);
const live = `/pt/blog/${slug}/`;
if (redirect) return Astro.redirect(live);

const { title, draftCommittedAt, draftMsg, date } = entry.data;
const verDate = draftCommittedAt ? new Date(draftCommittedAt) : date;
const rawUrl = rawContentUrl(entry.id);
const githubUrl = githubBlobUrl(entry.id) ?? `https://github.com/franklinbaldo/franklinbaldo.github.io`;
---

<PageLayout
  title={`${title} — versão arquivada`}
  description={entry.data.description}
  type="article"
  lang="pt"
  canonicalOverride={live}
  noindex={true}
>
  <div class="post-grid">
    <div class="post-body">
      <nav aria-label="Navegação" class="post-breadcrumb">
        <ol>
          <li><a href="/pt/">Início</a></li>
          <li><a href="/pt/archive/">Arquivo</a></li>
          <li><a href={live}>{title}</a></li>
          <li aria-current="page">versão arquivada</li>
        </ol>
      </nav>

      <VersionBanner liveHref={live} date={verDate} lang="pt" msg={draftMsg} />

      <article data-pagefind-ignore lang="pt-BR">
        <header><h1>{title}</h1></header>
        <ArchivedContent rawUrl={rawUrl} githubUrl={githubUrl} lang="pt" />
      </article>

      <BackToTop />
    </div>
  </div>
</PageLayout>

<style>
  .post-breadcrumb {
    margin-bottom: calc(var(--pico-spacing) * 0.75);
  }
  .post-breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--pico-muted-color);
  }
  .post-breadcrumb li + li::before {
    content: " / ";
    padding: 0 0.35em;
    color: var(--pico-muted-color);
  }
  .post-breadcrumb a {
    color: var(--pico-muted-color);
    text-decoration: none;
  }
  .post-breadcrumb [aria-current="page"] {
    color: var(--pico-color);
  }
</style>
