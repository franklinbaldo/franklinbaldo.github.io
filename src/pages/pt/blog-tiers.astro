---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import { isPublished } from "../../lib/publish";
import {
  BLOG_POST_TIERS_UPDATED,
  blogPostTiers,
  type BlogPostTier,
} from "../../data/blog-post-tiers";

const allPosts = await getCollection("blog");
const postByKey = new Map<
  string,
  { title: string; slug: string; lang: string }
>();

for (const post of allPosts) {
  if (!isPublished(post)) continue;
  const key = post.data.translationKey;
  if (!key) continue;
  const lang = post.data.lang ?? "en";
  const existing = postByKey.get(key);
  if (!existing || lang === "pt") {
    postByKey.set(key, {
      title: post.data.title,
      slug: post.data.slug ?? post.id,
      lang,
    });
  }
}

const tiers: BlogPostTier[] = ["S", "A", "B", "C", "D", "F"];
const qualityCounts = Object.fromEntries(
  tiers.map((tier) => [tier, blogPostTiers.filter((post) => post.qualityTier === tier).length]),
);
const interestCounts = Object.fromEntries(
  tiers.map((tier) => [tier, blogPostTiers.filter((post) => post.interestTier === tier).length]),
);

const nf2 = new Intl.NumberFormat("pt-BR", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const fmt = (value: number | null) => (value === null ? "—" : nf2.format(value));
---

<PageLayout
  title="Tiers dos posts | Franklin Baldo"
  description="Avaliação editorial dos posts do blog, ancorada no Hrönir e mantida em registros OKF por obra conceitual."
  lang="pt"
>
  <main class="tiers-shell">
    <header class="hero">
      <p class="eyebrow">TIER BOARD · ATUALIZADO {BLOG_POST_TIERS_UPDATED}</p>
      <h1>Tiers dos posts</h1>
      <p class="lede">
        O ranking Hrönir responde <em>quem está vencendo os duelos?</em>. Este quadro responde uma
        pergunta diferente: <strong>que nível editorial a evidência acumulada sustenta?</strong>
        OpenSkill, estrelas absolutas, qualidade de-confundida e perspectivas entram como evidência;
        nenhuma delas vira a letra automaticamente.
      </p>
      <div class="hero-notes">
        <span>🧭 uma ficha por <code>translationKey</code></span>
        <span>⚔️ Hrönir como evidência primária</span>
        <span>✨ interesse separado de qualidade</span>
        <span>🪶 S é raro e precisa ser merecido</span>
      </div>
    </header>

    <section class="scoreboard" aria-label="Resumo dos tiers">
      <div>
        <p class="kicker">QUALIDADE</p>
        <div class="tier-strip">
          {tiers.map((tier) => <span><b>{tier}</b> {qualityCounts[tier] ?? 0}</span>)}
        </div>
      </div>
      <div>
        <p class="kicker">INTERESSE / FERTILIDADE</p>
        <div class="tier-strip">
          {tiers.map((tier) => <span><b>{tier}</b> {interestCounts[tier] ?? 0}</span>)}
        </div>
      </div>
    </section>

    <section aria-labelledby="quality-heading">
      <div class="section-heading">
        <div>
          <p class="kicker">QUALIDADE EDITORIAL</p>
          <h2 id="quality-heading">A liga</h2>
        </div>
        <p>
          S exige qualidade absoluta forte, repetição, diversidade de perspectivas e ausência de
          fraqueza material não resolvida. Estar em primeiro no ranking, sozinho, não basta.
        </p>
      </div>

      <div class="tier-board">
        {tiers.map((tier) => {
          const records = blogPostTiers.filter((post) => post.qualityTier === tier);
          return (
            <section class={`tier-row tier-${tier.toLowerCase()}`} aria-label={`Tier ${tier}`}>
              <div class="tier-letter" aria-hidden="true">{tier}</div>
              <div class="tier-content">
                {records.length === 0 ? (
                  <p class="empty-tier">vazio — ninguém ganhou esse lugar ainda</p>
                ) : (
                  <div class="cards">
                    {records.map((record) => {
                      const post = postByKey.get(record.translationKey);
                      const ev = record.evidence;
                      return (
                        <article class="post-card" id={record.translationKey}>
                          <div class="badges">
                            <span class="quality-badge">qualidade {record.qualityTier}</span>
                            <span class="interest-badge">interesse {record.interestTier}</span>
                            <span class="confidence-badge">conf. {record.confidence}</span>
                          </div>
                          <h3>{post?.title ?? record.translationKey}</h3>
                          <p class="key">{record.translationKey}</p>
                          <p>{record.summary}</p>

                          <div class="evidence-strip" aria-label="Evidência Hrönir atual">
                            <div><strong>{ev.rank ? `#${ev.rank}` : "—"}</strong><span>ranking</span></div>
                            <div><strong>{fmt(ev.ordinal)}</strong><span>ordinal</span></div>
                            <div><strong>{fmt(ev.absoluteStars)}</strong><span>estrelas EWMA</span></div>
                            <div><strong>{fmt(ev.deconfoundedQuality)}</strong><span>de-confundido</span></div>
                            <div><strong>{ev.wins}/{ev.appearances}</strong><span>V/N</span></div>
                            <div><strong>{ev.perspectiveTop10Count}/{ev.perspectiveCount}</strong><span>persp. top 10</span></div>
                          </div>

                          <details>
                            <summary>Ver ficha editorial</summary>
                            <div class="evidence-grid">
                              <div>
                                <h4>O que sustenta</h4>
                                <ul>{record.strengths.map((item) => <li>{item}</li>)}</ul>
                              </div>
                              <div>
                                <h4>O que segura</h4>
                                <ul>{record.openProblems.map((item) => <li>{item}</li>)}</ul>
                              </div>
                            </div>
                            <p class="technical">
                              <strong>Hrönir atual:</strong> μ {fmt(ev.mu)} · σ {fmt(ev.sigma)} ·
                              estrelas n={ev.absoluteN} · de-confundido n={ev.deconfoundedN} ·
                              {ev.perspectiveCount} perspectivas com aparição.
                            </p>
                            <h4>Histórico do tier</h4>
                            <ul>{record.history.map((item) => <li>{item}</li>)}</ul>
                            {record.note && <p class="note">{record.note}</p>}
                            <p class="review-meta">
                              revisão {record.reviewedAt} · base <code>{record.reviewedRevision.slice(0, 12)}</code>
                            </p>
                          </details>

                          <div class="links">
                            {post && (
                              <a href={`/${post.lang === "pt" ? "pt/" : ""}blog/${post.slug}/`}>
                                ler post ↗
                              </a>
                            )}
                            <a href={`/ranking/posts/${record.translationKey}/`}>dossiê Hrönir ↗</a>
                          </div>
                        </article>
                      );
                    })}
                  </div>
                )}
              </div>
            </section>
          );
        })}
      </div>
    </section>

    <section class="method" aria-labelledby="method-heading">
      <p class="kicker">CONTRATO</p>
      <h2 id="method-heading">A letra não é um percentil.</h2>
      <p>
        <strong>Qualidade</strong> combina argumento, clareza, originalidade, estrutura, calibração
        epistemológica, memorabilidade e sobrevivência a perspectivas diferentes.
        <strong> Interesse</strong> mede fertilidade, singularidade, surpresa e vontade de reler ou
        continuar a conversa. <strong>Confiança</strong> mede cobertura e concordância da evidência.
      </p>
      <p>
        Os números acima são calculados diretamente dos arquivos Hrönir em cada build; as fichas OKF
        guardam apenas a decisão editorial e seu histórico. Se um post mudar materialmente, a ficha deve
        ser revista — não herda a letra por inércia.
      </p>
    </section>
  </main>
</PageLayout>

<style>
  .tiers-shell{--ink:var(--pico-color);--muted:var(--pico-muted-color);--line:var(--pico-muted-border-color);--panel:var(--pico-card-background-color,var(--pico-background-color));--soft:color-mix(in srgb,var(--pico-background-color) 92%,var(--pico-primary) 8%);max-width:1180px;margin:0 auto;padding-bottom:5rem}.hero{margin:1.5rem 0 3rem;padding:clamp(2rem,7vw,5rem);border:1px solid var(--line);border-radius:var(--radius-large);background:linear-gradient(145deg,color-mix(in srgb,var(--pico-primary) 20%,var(--pico-background-color)),var(--panel));box-shadow:var(--elevation-card)}.eyebrow,.kicker{font:800 .75rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase}.hero h1{margin:.4rem 0 1rem;font-size:clamp(3.5rem,10vw,7rem);line-height:.86;letter-spacing:-.065em}.lede{max-width:900px;font-size:clamp(1.05rem,2vw,1.35rem);line-height:1.5}.hero-notes{display:flex;flex-wrap:wrap;gap:.55rem;margin-top:1.4rem}.hero-notes span{padding:.45rem .7rem;border:1px solid var(--line);border-radius:999px;background:var(--panel);font-size:.8rem;font-weight:700}.scoreboard{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:3rem 0}.scoreboard>div{padding:1rem;border:1px solid var(--line);background:var(--soft)}.tier-strip{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.7rem}.tier-strip span{border:1px solid var(--ink);padding:.35rem .5rem;font:700 .78rem/1 ui-monospace,monospace}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin:4rem 0 1rem}.section-heading h2,.method h2{margin:.15rem 0 0;font-size:clamp(2rem,5vw,3.4rem);letter-spacing:-.045em}.section-heading>p{max-width:430px;color:var(--muted);text-align:right}.tier-board{overflow:hidden;border:1px solid var(--line);border-radius:var(--radius-large);box-shadow:var(--elevation-soft)}.tier-row{display:grid;grid-template-columns:82px 1fr;min-height:100px;border-bottom:1px solid var(--line)}.tier-row:last-child{border-bottom:0}.tier-letter{display:grid;place-items:center;border-right:1px solid var(--line);font-size:3rem;font-weight:950;color:#17151c}.tier-s .tier-letter{background:#f2bd2f}.tier-a .tier-letter{background:#88ddd2}.tier-b .tier-letter{background:#b9d99a}.tier-c .tier-letter{background:#a9cfdf}.tier-d .tier-letter{background:#c9c1df}.tier-f .tier-letter{background:#dfb1a3}.tier-content{padding:1rem;background:var(--soft)}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:1rem}.post-card{display:flex;flex-direction:column;padding:1.05rem;border:1px solid var(--line);border-radius:var(--radius-medium);background:var(--panel)}.post-card h3{margin:.65rem 0 .15rem;font-size:1.35rem;line-height:1.08}.key{margin:0 0 .8rem;color:var(--muted);font:700 .76rem/1.2 ui-monospace,monospace}.badges{display:flex;flex-wrap:wrap;gap:.35rem}.badges span{padding:.25rem .42rem;border:1px solid var(--ink);font:700 .68rem/1 ui-monospace,monospace;text-transform:uppercase}.quality-badge{background:color-mix(in srgb,var(--pico-background-color) 72%,#88ddd2 28%)}.interest-badge{background:color-mix(in srgb,var(--pico-background-color) 72%,#bba8ff 28%)}.confidence-badge{background:var(--soft)}.evidence-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:1rem 0;background:var(--line);border:1px solid var(--line)}.evidence-strip div{display:flex;flex-direction:column;padding:.65rem;background:var(--panel)}.evidence-strip strong{font:800 .95rem/1.1 ui-monospace,monospace}.evidence-strip span{margin-top:.2rem;color:var(--muted);font-size:.68rem;text-transform:uppercase}details{margin-top:.3rem;padding-top:.7rem;border-top:1px dashed var(--line)}summary{cursor:pointer;font-weight:800}.evidence-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:.8rem}.evidence-grid ul{padding-left:1.2rem}.evidence-grid li{margin-bottom:.45rem;line-height:1.4}.technical,.review-meta{font-size:.82rem;color:var(--muted);line-height:1.45}.note{padding:.7rem;background:var(--soft)}.links{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:auto;padding-top:1rem}.links a{font-weight:800;text-decoration:none}.empty-tier{margin:1rem;color:var(--muted);font-style:italic}.method{margin-top:4rem;padding:2rem;border-radius:var(--radius-large);background:var(--ink);color:var(--pico-background-color)}.method p{max-width:920px;line-height:1.6}@media(max-width:800px){.scoreboard,.evidence-grid{grid-template-columns:1fr}.section-heading{align-items:start;flex-direction:column;gap:.6rem}.section-heading>p{text-align:left}.tier-row{grid-template-columns:58px 1fr}.tier-letter{font-size:2rem}.cards{grid-template-columns:1fr}.evidence-strip{grid-template-columns:repeat(2,1fr)}}
</style>
