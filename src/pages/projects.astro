---
import PageLayout from "../layouts/PageLayout.astro";
import { repoDescriptionLang } from "../lib/repoDescriptionLang";
import TierBoard, { type TierBoardStrings } from "../components/TierBoard.astro";
import { projectTiers } from "../data/project-tiers";
import type { TierBoardItem } from "../data/tier-types";

const PAGE_LANG = "en";
const USER = "franklinbaldo";
const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;

interface Repo {
  name: string;
  full_name: string;
  description: string | null;
  html_url: string;
  homepage: string | null;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
  pushed_at: string;
  topics: string[];
  fork: boolean;
  archived: boolean;
  private: boolean;
}

let repos: Repo[] = [];
let error: string | null = null;

try {
  const res = await fetch(
    `https://api.github.com/users/${USER}/repos?per_page=100&sort=updated`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
        ...(token ? { Authorization: `Bearer ${token}` } : {}),
      },
    }
  );
  if (!res.ok) throw new Error(`GitHub API ${res.status}: ${await res.text()}`);
  const data = (await res.json()) as Repo[];
  repos = data
    .filter((r) => !r.fork && !r.archived && !r.private)
    .sort(
      (a, b) =>
        b.stargazers_count - a.stargazers_count ||
        new Date(b.pushed_at).valueOf() - new Date(a.pushed_at).valueOf()
    );
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  console.warn(`[projects] failed to fetch repos: ${error}`);
}

const fmt = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "2-digit" });

const projectTierItems: TierBoardItem[] = projectTiers.map((record) => {
  const live = repos.find((repo) => repo.full_name === record.repository);
  return {
    id: `project-tier-${record.slug}`,
    title: record.name,
    href: live?.html_url ?? `https://github.com/${record.repository}`,
    qualityTier: record.qualityTier,
    interestTier: record.interestTier,
    confidence: record.confidence,
    summary: record.summary,
    reviewedAt: record.reviewedAt,
    note: record.note,
    strengths: record.strengths,
    openProblems: record.openProblems,
    history: record.history,
    evidence: live
      ? [
          { label: "stars", value: live.stargazers_count },
          { label: "forks", value: live.forks_count },
          { label: "language", value: live.language ?? "—" },
          { label: "updated", value: fmt.format(new Date(live.pushed_at)) },
        ]
      : [],
  };
});

const projectTierStrings: TierBoardStrings = {
  heading: "Project tiers",
  description:
    "Quality measures project execution; interest measures originality, leverage and fertility. Stars and activity are evidence, not the letter definition.",
  qualityLabel: "quality",
  interestLabel: "interest",
  confidenceLabel: "conf.",
  summaryQualityLabel: "quality",
  summaryInterestLabel: "interest / fertility",
  emptyTier: "empty — no project classified here yet",
  emptyBoard:
    "The infrastructure is ready; the hourly routine has not produced its first canonical project card yet.",
  detailsLabel: "View project card",
  strengthsHeading: "What supports it",
  openProblemsHeading: "What holds it back",
  historyHeading: "Tier history",
  reviewedLabel: "reviewed",
};
---

<PageLayout
  title="Project tiers | Franklin Baldo"
  description="Canonical tiers for public projects, with the GitHub catalog retained as evidence and discovery."
  lang="en"
  image="/og/projects.png"
  translations={{ pt: "/pt/projects/" }}
>
  <hgroup>
    <h1>Project tiers</h1>
    <p><small>
      Editorial tiers for public projects from <a href={`https://github.com/${USER}`}>@{USER}</a>,
      sorted by stars · last fetched at build
    </small></p>
  </hgroup>

  <TierBoard items={projectTierItems} strings={projectTierStrings} id="project-tiers" />

  <h2>Project catalog</h2>

  {error && (
    <p><small>
      Couldn't load the live list (<code>{error.slice(0, 120)}</code>).
      Visit <a href={`https://github.com/${USER}?tab=repositories`}>my GitHub</a> directly.
    </small></p>
  )}

  {repos.length === 0 && !error && <p>No public repos to show right now.</p>}

  {repos.map((repo) => (
    <article>
      <header>
        <hgroup>
          <h3><a href={repo.html_url}>{repo.name}</a> {repo.stargazers_count > 0 && <mark>★ {repo.stargazers_count}</mark>}</h3>
          {repo.description && (
            <p lang={repoDescriptionLang(repo.name) !== PAGE_LANG ? repoDescriptionLang(repo.name) : undefined}>
              {repo.description}
            </p>
          )}
        </hgroup>
      </header>
      <footer>
        <small>
          {repo.language && <><kbd>{repo.language}</kbd> · </>}
          {repo.forks_count > 0 && <>⑂ {repo.forks_count} · </>}
          updated <time datetime={repo.pushed_at}>{fmt.format(new Date(repo.pushed_at))}</time>
          {repo.homepage && <> · <a href={repo.homepage} aria-label={`${repo.name} site`}>↗ site</a></>}
        </small>
      </footer>
    </article>
  ))}
</PageLayout>
