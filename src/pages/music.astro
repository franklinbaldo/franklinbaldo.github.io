---
import PageLayout from "../layouts/PageLayout.astro";
import { sleep } from "../lib/suno";
import { getCollection } from "astro:content";

const HANDLE = "franklinbaldo";
const SUNO_API = "https://studio-api-prod.suno.com/api";

interface Clip {
  id: string;
  title: string;
  audio_url: string;
  image_url: string;
  image_large_url?: string;
  created_at: string;
  play_count: number;
  upvote_count: number;
  major_model_version?: string;
  metadata?: {
    tags?: string;
    prompt?: string;
    duration?: number | null;
    make_instrumental?: boolean;
  };
  is_public: boolean;
}

interface Playlist {
  id: string;
  name: string;
  description?: string;
  image_url: string;
  song_count: number;
  total_duration?: number;
  play_count?: number;
  upvote_count?: number;
  is_public: boolean;
  playlist_clips?: { clip: Clip; relative_index: number }[];
}

interface ProfileResponse {
  clips: Clip[];
  playlists: Playlist[];
  num_total_clips: number;
  display_name: string;
  profile_description?: string;
  avatar_image_url: string;
}

let clips: Clip[] = [];
let playlists: Playlist[] = [];
let profile: ProfileResponse | null = null;
let error: string | null = null;

async function fetchJSON<T>(url: string): Promise<T> {
  for (let attempt = 0; attempt < 4; attempt++) {
    const res = await fetch(url, { headers: { Accept: "application/json" } });
    if (res.ok) return (await res.json()) as T;
    if ((res.status === 429 || res.status >= 500) && attempt < 3) {
      await sleep(1000 * Math.pow(2, attempt));
      continue;
    }
    throw new Error(`HTTP ${res.status} on ${url}`);
  }
  throw new Error(`exhausted retries on ${url}`);
}

try {
  const first = await fetchJSON<ProfileResponse>(
    `${SUNO_API}/profiles/${HANDLE}/?page=1&playlists_sort_by=created_at&clips_sort_by=created_at`
  );
  profile = first;
  playlists = (first.playlists ?? []).filter((p) => p.is_public);

  const total = Math.max(0, first.num_total_clips ?? 0);
  const seen = new Set<string>();
  for (const c of first.clips ?? []) {
    if (!seen.has(c.id)) { seen.add(c.id); clips.push(c); }
  }
  let page = 2;
  while (clips.length < total) {
    const next = await fetchJSON<ProfileResponse>(
      `${SUNO_API}/profiles/${HANDLE}/?page=${page}&playlists_sort_by=created_at&clips_sort_by=created_at`
    );
    const got = next.clips ?? [];
    if (got.length === 0) break;
    for (const c of got) {
      if (!seen.has(c.id)) { seen.add(c.id); clips.push(c); }
    }
    page++;
  }

  clips = clips
    .filter((c) => c.is_public)
    .sort(
      (a, b) =>
        new Date(b.created_at).valueOf() - new Date(a.created_at).valueOf()
    );
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  console.warn(`[musicas] failed: ${error}`);
}

const fmtDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
});

function fmtDuration(sec?: number | null): string {
  if (!sec || sec <= 0) return "";
  const total = Math.round(sec);
  const m = Math.floor(total / 60);
  const s = total % 60;
  return `${m}:${s.toString().padStart(2, "0")}`;
}

function parseTags(raw?: string): string[] {
  if (!raw) return [];
  return raw
    .split(/[,;]/)
    .map((t) => t.trim())
    .filter(Boolean)
    .slice(0, 6);
}

const musicJsonLd = {
  "@context": "https://schema.org",
  "@type": "MusicPlaylist",
  "name": "Music by Franklin Baldo",
  "description": "Songs and playlists published on Suno by Franklin Baldo.",
  "url": "https://franklinbaldo.github.io/music/",
  "numTracks": clips.length,
  "track": clips.slice(0, 20).map((c) => ({
    "@type": "MusicRecording",
    "name": c.title || "(untitled)",
    "url": `https://suno.com/song/${c.id}`,
    "datePublished": c.created_at?.split("T")[0],
    "duration": c.metadata?.duration ? `PT${Math.floor(c.metadata.duration / 60)}M${Math.round(c.metadata.duration % 60)}S` : undefined,
  })).filter((t) => t.name),
};

// Genre data from blog post frontmatter (clean tags)
const musicBlogPosts = await getCollection(
  "blog",
  (e) => e.data.postType === "music" && !!e.data.sunoId && (e.data.genre?.length ?? 0) > 0,
);
const sunoIdToGenres = new Map<string, string[]>(
  musicBlogPosts.map((p) => [
    p.data.sunoId!,
    (p.data.genre ?? []).map((g) => g.toLowerCase().trim()).filter(Boolean),
  ]),
);
const allGenres = [...new Set([...sunoIdToGenres.values()].flat())].sort();
const showGenreChips =
  allGenres.length >= 2 &&
  allGenres.length <= 25 &&
  allGenres.every((g) => g.length <= 40);
---

<PageLayout
  title="Music | Franklin Baldo"
  description="Songs and playlists published on Suno, fetched live at build time."
  lang="en"
  image="/og/music.png"
  translations={{ pt: "/pt/musicas/" }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(musicJsonLd)} is:inline />
  <hgroup>
    <h1>Music</h1>
    <p><small>
      Public songs from <a href={`https://suno.com/@${HANDLE}`}>@{HANDLE}</a> on Suno,
      sorted by most recent · updated at build time.
    </small></p>
  </hgroup>

  {error && (
    <p><small>
      Couldn't load songs right now (<code>{error.slice(0, 120)}</code>).
      See them directly at <a href={`https://suno.com/@${HANDLE}`}>suno.com/@{HANDLE}</a>.
    </small></p>
  )}

  {playlists.length > 0 && (
    <section>
      <h2>Playlists</h2>
      <div class="playlists-grid">
        {playlists.map((p) => (
          <article class="playlist-card">
            <a href={`https://suno.com/playlist/${p.id}`}>
              <img src={p.image_url} alt={`Cover art for playlist ${p.name}`} loading="lazy" width="200" height="200" />
            </a>
            <header>
              <h3><a href={`https://suno.com/playlist/${p.id}`}>{p.name}</a></h3>
              {p.description && <p><small>{p.description}</small></p>}
            </header>
            <footer>
              <small>
                {p.song_count} {p.song_count === 1 ? "song" : "songs"}
                {p.total_duration ? ` · ${fmtDuration(p.total_duration)}` : ""}
              </small>
            </footer>
          </article>
        ))}
      </div>
    </section>
  )}

  <section id="favorites-section" hidden>
    <h2>Favorites</h2>
    <div class="songs-grid" id="favorites-grid"></div>
  </section>

  <section id="history-section" hidden>
    <h2>Recently played</h2>
    <div class="history-rail" id="history-rail"></div>
  </section>

  {clips.length > 0 && (
    <section>
      {showGenreChips && (
        <div class="genre-chips" id="genre-chips" role="group" aria-label="Filter by genre">
          <button class="genre-chip active" data-genre="all" type="button">All</button>
          {allGenres.map((g) => (
            <button class="genre-chip" data-genre={g} type="button">{g}</button>
          ))}
        </div>
      )}
      <div class="songs-header">
        <h2>All songs <small>({clips.length})</small></h2>
        <div class="songs-controls">
          <button id="gmp-play-all" type="button" data-ids={clips.map((c) => c.id).join(",")}>▶ Play all</button>
          <button id="gmp-shuffle-all" type="button" data-ids={clips.map((c) => c.id).join(",")}>⇌ Shuffle</button>
          <select id="sort-songs" aria-label="Sort by">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="duration-desc">Longest</option>
            <option value="duration-asc">Shortest</option>
          </select>
        </div>
      </div>
      <div class="songs-grid" id="songs-grid">
        {clips.map((c) => {
          const tags = parseTags(c.metadata?.tags);
          const duration = fmtDuration(c.metadata?.duration);
          const lyrics = c.metadata?.prompt ?? "";
          return (
            <article
              class="song-card"
              id={c.id}
              data-suno-id={c.id}
              data-date={c.created_at}
              data-duration={String(c.metadata?.duration || 0)}
              data-genres={(sunoIdToGenres.get(c.id) ?? []).join(",")}
              data-title={c.title || "(untitled)"}
              data-image={c.image_url || ""}
            >
              <a href={`https://suno.com/song/${c.id}`} class="cover">
                <img
                  src={c.image_url}
                  alt={`Cover art for ${c.title}`}
                  loading="lazy"
                  width="300"
                  height="300"
                />
              </a>
              <header>
                <h3>
                  <a href={`https://suno.com/song/${c.id}`}>{c.title || "(untitled)"}</a>
                </h3>
                <p>
                  <small>
                    <time datetime={c.created_at}>{fmtDate.format(new Date(c.created_at))}</time>
                    {duration && <> · {duration}</>}
                    {c.major_model_version && <> · {c.major_model_version}</>}
                  </small>
                </p>
              </header>

              {c.audio_url && (
                <audio controls preload="none" src={c.audio_url}></audio>
              )}

              {tags.length > 0 && (
                <p class="tags">
                  {tags.map((t) => <kbd>{t}</kbd>)}
                </p>
              )}

              <footer>
                <div class="card-footer-row">
                  <small>▶ {c.play_count ?? 0} · ♥ {c.upvote_count ?? 0}</small>
                  <button
                    class="fav-btn"
                    type="button"
                    data-suno-id={c.id}
                    aria-label="Add to favorites"
                    aria-pressed="false"
                  >♡</button>
                </div>
                {lyrics.trim() && (
                  <details>
                    <summary><small>Lyrics</small></summary>
                    <pre class="lyrics">{lyrics}</pre>
                  </details>
                )}
              </footer>
            </article>
          );
        })}
      </div>
    </section>
  )}
</PageLayout>

<script>
  function getFavs(): string[] {
    try { return JSON.parse(localStorage.getItem("gmp-favorites") || "[]"); } catch { return []; }
  }
  function getHistory(): string[] {
    try { return JSON.parse(localStorage.getItem("gmp-history") || "[]"); } catch { return []; }
  }
  function allCards(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>("#songs-grid .song-card"));
  }
  function cardById(id: string): HTMLElement | null {
    return document.querySelector<HTMLElement>(`#songs-grid .song-card[data-suno-id="${id}"]`);
  }

  function refreshFavButtons() {
    const favs = getFavs();
    document.querySelectorAll<HTMLButtonElement>(".fav-btn").forEach((btn) => {
      const id = btn.dataset.sunoId || "";
      const active = favs.includes(id);
      btn.textContent = active ? "♥" : "♡";
      btn.setAttribute("aria-pressed", String(active));
      btn.setAttribute("aria-label", active ? "Remove from favorites" : "Add to favorites");
      btn.classList.toggle("active", active);
    });
  }

  function renderFavoritesSection() {
    const section = document.getElementById("favorites-section") as HTMLElement | null;
    const grid = document.getElementById("favorites-grid") as HTMLElement | null;
    if (!section || !grid) return;
    const favs = getFavs();
    const currentId = localStorage.getItem("gmp-suno-id") || "";
    if (!favs.length) { section.hidden = true; return; }
    section.hidden = false;
    grid.innerHTML = "";
    favs.slice(0, 12).forEach((id) => {
      const source = cardById(id);
      if (!source) return;
      const mini = document.createElement("article");
      mini.className = "song-card mini-card" + (id === currentId ? " is-playing" : "");
      mini.dataset.sunoId = id;
      const img = document.createElement("img");
      img.src = source.dataset.image || "";
      img.alt = source.dataset.title || "";
      img.width = 80; img.height = 80;
      img.style.cssText = "width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:var(--pico-border-radius);cursor:pointer";
      img.addEventListener("click", () =>
        document.dispatchEvent(new CustomEvent("gp:play", { detail: { sunoId: id, title: source.dataset.title } }))
      );
      const title = document.createElement("p");
      title.style.cssText = "font-size:0.8rem;margin:0.25rem 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis";
      title.textContent = source.dataset.title || "";
      mini.appendChild(img);
      mini.appendChild(title);
      grid.appendChild(mini);
    });
  }

  function renderHistorySection() {
    const section = document.getElementById("history-section") as HTMLElement | null;
    const rail = document.getElementById("history-rail") as HTMLElement | null;
    if (!section || !rail) return;
    const history = getHistory().slice(0, 8);
    const currentId = localStorage.getItem("gmp-suno-id") || "";
    if (!history.length) { section.hidden = true; return; }
    section.hidden = false;
    rail.innerHTML = "";
    history.forEach((id) => {
      const source = cardById(id);
      if (!source) return;
      const item = document.createElement("div");
      item.className = "history-item" + (id === currentId ? " is-playing" : "");
      item.dataset.sunoId = id;
      const img = document.createElement("img");
      img.src = source.dataset.image || "";
      img.alt = source.dataset.title || "";
      img.style.cssText = "width:56px;height:56px;object-fit:cover;border-radius:var(--pico-border-radius);cursor:pointer;flex-shrink:0";
      img.addEventListener("click", () =>
        document.dispatchEvent(new CustomEvent("gp:play", { detail: { sunoId: id, title: source.dataset.title } }))
      );
      item.appendChild(img);
      rail.appendChild(item);
      // Continue listening badge
      if (id === currentId) {
        const badge = document.createElement("small");
        badge.style.cssText = "display:block;font-size:0.65rem;text-align:center;margin-top:2px;color:var(--pico-primary)";
        badge.textContent = "▶ Continue";
        item.appendChild(badge);
      }
    });
  }

  function initGallery() {
    const playAllBtn = document.getElementById("gmp-play-all") as HTMLButtonElement | null;
    const shuffleAllBtn = document.getElementById("gmp-shuffle-all") as HTMLButtonElement | null;
    const sortSelect = document.getElementById("sort-songs") as HTMLSelectElement | null;
    const grid = document.getElementById("songs-grid") as HTMLElement | null;
    const chipsContainer = document.getElementById("genre-chips") as HTMLElement | null;
    const gmp = document.getElementById("gmp");

    function getVisibleIds(): string[] {
      if (!grid) return [];
      return Array.from(grid.querySelectorAll<HTMLElement>(".song-card:not([hidden])"))
        .map((el) => el.dataset.sunoId || "").filter(Boolean);
    }

    if (playAllBtn) {
      playAllBtn.addEventListener("click", () =>
        document.dispatchEvent(new CustomEvent("gp:queue", { detail: { sunoIds: getVisibleIds() } }))
      );
    }
    if (shuffleAllBtn) {
      shuffleAllBtn.addEventListener("click", () => {
        const shuffled = [...getVisibleIds()].sort(() => Math.random() - 0.5);
        document.dispatchEvent(new CustomEvent("gp:queue", { detail: { sunoIds: shuffled } }));
      });
    }

    if (sortSelect && grid) {
      sortSelect.addEventListener("change", () => {
        const cards = Array.from(grid.querySelectorAll<HTMLElement>(".song-card"));
        cards.sort((a, b) => {
          const val = sortSelect.value;
          if (val === "newest" || val === "oldest") {
            const da = new Date(a.dataset.date || "").valueOf();
            const db = new Date(b.dataset.date || "").valueOf();
            return val === "newest" ? db - da : da - db;
          }
          const da = Number(a.dataset.duration || "0");
          const db = Number(b.dataset.duration || "0");
          return val === "duration-desc" ? db - da : da - db;
        });
        cards.forEach((c) => grid.appendChild(c));
      });
    }

    // Genre chips filter
    if (chipsContainer && grid) {
      chipsContainer.addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-genre]");
        if (!btn) return;
        const genre = btn.dataset.genre || "all";
        chipsContainer.querySelectorAll(".genre-chip").forEach((c) => c.classList.remove("active"));
        btn.classList.add("active");
        allCards().forEach((card) => {
          if (genre === "all") { card.hidden = false; return; }
          const genres = (card.dataset.genres || "").split(",");
          card.hidden = !genres.includes(genre);
        });
        const url = new URL(location.href);
        if (genre === "all") url.searchParams.delete("genre");
        else url.searchParams.set("genre", genre);
        history.replaceState({}, "", url);
      });
      // Restore from URL
      const urlGenre = new URL(location.href).searchParams.get("genre");
      if (urlGenre) {
        const chip = chipsContainer.querySelector<HTMLButtonElement>(`[data-genre="${urlGenre}"]`);
        if (chip) chip.click();
      }
    }

    // Fav toggles on cards
    document.querySelectorAll<HTMLButtonElement>(".fav-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.sunoId || "";
        if (!id) return;
        const favs = getFavs();
        const i = favs.indexOf(id);
        if (i === -1) favs.push(id);
        else favs.splice(i, 1);
        try { localStorage.setItem("gmp-favorites", JSON.stringify(favs)); } catch {}
        refreshFavButtons();
        renderFavoritesSection();
        if (gmp) gmp.dataset.favorites = favs.join(",");
      });
    });
    refreshFavButtons();
    renderFavoritesSection();
    renderHistorySection();

    // Card highlight
    if (!gmp || !grid) return;
    function updateHighlight() {
      const playingId = gmp!.dataset.playingId || "";
      allCards().forEach((card) => card.classList.toggle("is-playing", card.dataset.sunoId === playingId));
    }
    updateHighlight();
    const obs = new MutationObserver((mutations) => {
      updateHighlight();
      for (const m of mutations) {
        if (m.attributeName === "data-playing-id" || m.attributeName === "data-favorites") {
          refreshFavButtons();
          renderFavoritesSection();
          renderHistorySection();
        }
      }
    });
    obs.observe(gmp, { attributes: true, attributeFilter: ["data-playing-id", "data-favorites", "data-queue-ids"] });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }
  document.addEventListener("astro:page-load", initGallery);
</script>

<style>
  .songs-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .songs-header h2 { margin: 0; }
  .songs-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .songs-controls button {
    padding: 0.3rem 0.75rem;
    font-size: 0.85rem;
    border-radius: var(--pico-border-radius);
    cursor: pointer;
    border: 1px solid var(--pico-muted-border-color);
    background: var(--pico-card-background-color);
    color: var(--pico-color);
  }
  .songs-controls button:hover {
    background: var(--pico-primary);
    color: var(--pico-primary-inverse, #fff);
    border-color: var(--pico-primary);
  }
  .songs-controls select {
    padding: 0.3rem 0.5rem;
    font-size: 0.85rem;
    border-radius: var(--pico-border-radius);
    border: 1px solid var(--pico-muted-border-color);
    background: var(--pico-card-background-color);
    color: var(--pico-color);
    cursor: pointer;
  }
  .playlists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .playlist-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--pico-border-radius);
  }
  .playlist-card h3 { font-size: 1rem; margin: 0.5rem 0 0.25rem; }

  .songs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .song-card { display: flex; flex-direction: column; }
  .song-card .cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--pico-border-radius);
  }
  .song-card h3 { font-size: 1.05rem; margin: 0.5rem 0 0.25rem; }
  .song-card audio { width: 100%; margin: 0.5rem 0; }
  .song-card .tags { margin: 0.25rem 0; display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .song-card .tags kbd { font-size: 0.7rem; }
  .song-card .lyrics {
    white-space: pre-wrap;
    font-size: 0.85rem;
    max-height: 20rem;
    overflow-y: auto;
    background: var(--pico-code-background-color);
    padding: 0.75rem;
    border-radius: var(--pico-border-radius);
  }
  .card-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }
  .fav-btn {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1rem;
    padding: 0.1rem 0.3rem;
    line-height: 1;
    color: var(--pico-muted-color);
    transition: color 0.15s;
  }
  .fav-btn.active { color: #e53e3e; }
  .fav-btn:hover { color: #e53e3e; }
  .genre-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .genre-chip {
    padding: 0.2rem 0.65rem;
    font-size: 0.78rem;
    border-radius: 999px;
    border: 1px solid var(--pico-muted-border-color);
    background: var(--pico-card-background-color);
    color: var(--pico-muted-color);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .genre-chip.active,
  .genre-chip:hover {
    background: var(--pico-primary);
    color: var(--pico-primary-inverse, #fff);
    border-color: var(--pico-primary);
  }
  .history-rail {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }
  .history-item { display: flex; flex-direction: column; align-items: center; }
  #favorites-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
</style>
