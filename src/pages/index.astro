---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import RecentList from "../components/RecentList.astro";
import PathsTeaser from "../components/PathsTeaser.astro";
import HomeAuthorRail from "../components/HomeAuthorRail.astro";
import { isPublished } from "../lib/publish";

const all = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .filter((post) => (post.data.lang ?? 'en') === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latest = all[0];
// The featured card shows the latest essay, so the list starts at the second.
const recent = all.slice(1, 13);
const latestHref = latest ? `/blog/${latest.data.slug ?? latest.id}/` : "/archive/";
const latestWords = (latest?.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const latestMinutes = Math.max(1, Math.round(latestWords / 220));
const latestDate = latest?.data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<PageLayout
  title="Franklin Baldo — Essays, code, and music."
  description="Essays, code, and music at the border of AI, philosophy, literature, and intelligent systems."
  lang="en"
  translations={{ pt: "/pt/" }}
>
  <div class="home-layout">
    <div class="home-main">
      <section class="home-hero" aria-label="Introduction">
        <h1 class="home-title">Franklin Baldo<span class="home-title-dot" aria-hidden="true">.</span></h1>
        <p class="home-tagline">Essays, code, and music at the border of AI, philosophy, and literature.</p>
      </section>

      {latest && (
        <section class="home-featured" aria-label="Latest essay">
          <p class="section-eyebrow">Latest essay</p>
          <article class="featured-card">
            <h2 class="featured-title"><a href={latestHref}>{latest.data.title}</a></h2>
            {latest.data.description && <p class="featured-blurb">{latest.data.description}</p>}
            <p class="featured-meta">
              <time datetime={latest.data.date.toISOString()}>{latestDate}</time>
              <span aria-hidden="true">·</span>
              <span>{latestMinutes} min read</span>
              <a href={latestHref} class="featured-cta">Read essay →</a>
            </p>
          </article>
        </section>
      )}

      <section class="home-recent" aria-label="Recent essays">
        <p class="section-eyebrow">Recent essays</p>
        <RecentList posts={recent} lang="en" />
        <p class="home-archive-link">
          <small><a href="/archive/">View the full archive →</a></small>
        </p>
      </section>

      <PathsTeaser lang="en" />
    </div>

    <aside class="home-rail" aria-label="About the author">
      <HomeAuthorRail lang="en" />
    </aside>
  </div>
</PageLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  @media (min-width: 1100px) {
    .home-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
      align-items: start;
    }

    .home-rail {
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }
  }

  @media (max-width: 1099px) {
    .home-rail {
      border-top: 1px solid var(--pico-border-color);
      padding-top: var(--pico-spacing);
    }
  }

  .home-hero {
    position: relative;
    margin-block: clamp(2rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem) 0;
  }
  .home-hero::after {
    content: "";
    display: block;
    width: min(7rem, 28vw);
    height: 0.28rem;
    margin-top: 1.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--pico-primary), transparent);
  }
  .home-title {
    max-width: 11ch;
    font-size: clamp(3.2rem, 9vw, 6.4rem);
    line-height: .9;
    margin: 0 0 .8rem;
    letter-spacing: -0.065em;
  }
  .home-title-dot {
    color: var(--pico-primary);
  }
  .home-tagline {
    max-width: 42rem;
    color: var(--pico-muted-color);
    margin: 0;
    font-size: clamp(1.05rem, 2.3vw, 1.35rem);
    line-height: 1.5;
  }

  .section-eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--pico-primary);
  }

  .home-featured {
    margin-block: 0 calc(var(--pico-spacing) * 1.75);
  }
  .featured-card {
    position: relative;
    overflow: hidden;
    margin: 0;
    padding: clamp(1.4rem, 3.5vw, 2.25rem);
    background:
      linear-gradient(135deg, var(--surface-raised), var(--pico-card-background-color));
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--radius-large);
    box-shadow: var(--elevation-card);
  }
  .featured-card::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: .32rem;
    background: var(--pico-primary);
  }
  @media (hover: hover) {
    .featured-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--elevation-soft);
    }
  }
  .featured-title {
    margin: 0 0 0.5rem;
    max-width: 22ch;
    font-size: clamp(1.55rem, 3.8vw, 2.25rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
  }
  .featured-title a {
    color: inherit;
    text-decoration: none;
  }
  .featured-title a:hover {
    color: var(--pico-primary);
  }
  .featured-blurb {
    margin: 0 0 0.75rem;
    color: var(--pico-muted-color);
    line-height: 1.55;
  }
  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
    font-size: 0.85rem;
    color: var(--pico-muted-color);
    font-variant-numeric: oldstyle-nums;
  }
  .featured-cta {
    margin-left: auto;
    padding: .35rem .65rem;
    border-radius: 999px;
    background: var(--accent-wash);
    font-weight: 700;
    text-decoration: none;
  }

  .home-recent {
    margin-block: 0 calc(var(--pico-spacing) * 2.5);
    padding-top: .4rem;
  }
  .home-archive-link {
    margin-top: var(--pico-spacing);
  }
</style>
