---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import RecentList from "../components/RecentList.astro";
import PathsTeaser from "../components/PathsTeaser.astro";
import HomeAuthorRail from "../components/HomeAuthorRail.astro";
import { isPublished } from "../lib/publish";

const all = (await getCollection("blog"))
  .filter((post) => isPublished(post))
  .filter((post) => (post.data.lang ?? 'en') === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recent = all.slice(0, 12);
const latest = all[0];
const latestHref = latest ? `/blog/${latest.id}/` : "/archive/";
---

<PageLayout
  title="Franklin Baldo — Notes on AI, law, and systems."
  description="Essays on AI agency, process metaphysics, and legal design by Franklin Baldo, a State Attorney in Rondônia, Brazil."
  lang="en"
  translations={{ pt: "/pt/" }}
>
  <div class="home-layout">
    <div class="home-main">
      <section class="home-hero" aria-label="Introduction">
        <h1 class="home-title">Franklin Baldo</h1>
        <p class="home-tagline">Notes on AI, law, and systems.</p>
        <p class="home-cta">
          <a href={latestHref} class="contrast">Read latest essay →</a>
        </p>
      </section>

      <section class="home-recent" aria-label="Recent posts">
        <RecentList posts={recent} lang="en" />
        <p class="home-archive-link">
          <small><a href="/archive/">View the full archive →</a></small>
        </p>
      </section>

      <PathsTeaser lang="en" />
    </div>

    <aside class="home-rail" aria-label="About the author">
      <HomeAuthorRail lang="en" />
    </aside>
  </div>
</PageLayout>

<style>
  .home-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  @media (min-width: 1100px) {
    .home-layout {
      grid-template-columns: minmax(0, 1fr) 220px;
      align-items: start;
    }

    .home-rail {
      position: sticky;
      top: 4.5rem;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
  }

  @media (max-width: 1099px) {
    .home-rail {
      display: none;
    }
  }

  .home-hero {
    margin-block: calc(var(--pico-spacing) * 1.25) calc(var(--pico-spacing) * 1.5);
  }
  .home-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 .25rem;
    letter-spacing: -0.01em;
  }
  .home-tagline {
    color: var(--pico-muted-color);
    margin: 0;
    font-size: 1rem;
  }
  .home-recent {
    margin-block: calc(var(--pico-spacing) * 1.5) calc(var(--pico-spacing) * 2);
  }
  .home-cta {
    margin: calc(var(--pico-spacing) * 0.75) 0 0;
  }
  .home-cta a {
    font-size: 0.95rem;
    font-weight: 500;
  }
  .home-archive-link {
    margin-top: var(--pico-spacing);
  }
</style>
