---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "../../../../layouts/PageLayout.astro";
import VersionBanner from "../../../../components/VersionBanner.astro";
import ArchivedContent from "../../../../components/ArchivedContent.astro";
import MermaidEnhancer from "../../../../components/MermaidEnhancer.astro";
import BackToTop from "../../../../components/BackToTop.astro";
import Breadcrumbs from "../../../../components/Breadcrumbs.astro";
import {
  uuidForId,
  legacyUuidForId,
  preOkfUuidForId,
  slugOf,
  archivedContentUrls,
  GITHUB_REPO,
} from "../../../../lib/versions.js";
import {
  type HistoryEntry,
  listHistoryEntries,
  historyUuids,
  historyRawPath,
  historyGithubUrl,
} from "../../../../lib/history-pages.js";

// RFC 0010: content-addressed version pages. Every non-selected version file
// gets /blog/<slug>/v/<uuid>. A UUID that is *currently* the selected version
// redirects to /blog/<slug> so permalinks stay stable across selection swaps.
// For non-selected versions, the pre-RFC-0010 body-only legacy UUID renders
// the same archived content (not a redirect) — only selected/pruned versions
// redirect. All version pages are noindex with canonical → live.
//
// RFC 0015: versions archived in versions-history.json (flattened slugs — no
// file on disk) also keep their permalinks: their pages resolve metadata from
// the history entry and fetch the body from the blob-backed raw.txt endpoint.
type PageProps =
  | {
      entry: CollectionEntry<"blogVersions"> | CollectionEntry<"blog">;
      redirect: boolean;
      archived?: undefined;
      rawUrl?: undefined;
    }
  | {
      entry?: undefined;
      redirect?: false;
      archived: HistoryEntry;
      rawUrl: string | null;
    };

export async function getStaticPaths() {
  const [versions, canon] = await Promise.all([
    getCollection("blogVersions"),
    getCollection("blog"),
  ]);
  const paths: Array<{
    params: { slug: string; uuid: string };
    props: PageProps;
  }> = [];
  const seen = new Set<string>();
  const push = (
    slug: string,
    uuid: string | null | undefined,
    props: PageProps
  ) => {
    const k = `${slug}/${uuid}`;
    if (!uuid || seen.has(k)) return;
    seen.add(k);
    paths.push({ params: { slug, uuid }, props });
  };
  for (const v of versions) {
    if ((v.data.lang ?? "en") === "pt") continue;
    const slug = slugOf(v.id);
    const uuid = uuidForId(v.id);
    if (!uuid) continue; // file gone / unresolved → skip rather than crash
    push(slug, uuid, { entry: v, redirect: false });
    const legacy = legacyUuidForId(v.id);
    if (legacy && legacy !== uuid) {
      push(slug, legacy, { entry: v, redirect: false });
    }
    const preOkf = preOkfUuidForId(v.id);
    if (preOkf && preOkf !== uuid && preOkf !== legacy) {
      push(slug, preOkf, { entry: v, redirect: false });
    }
  }
  for (const c of canon) {
    if ((c.data.lang ?? "en") === "pt") continue;
    // Every selected version keeps its /v/<uuid> permalink as a redirect:
    // any peer may have served an archived page under these UUIDs before
    // winning selection, and selection swaps must not 404 old links.
    push(c.id, uuidForId(c.id), { entry: c, redirect: true });
    push(c.id, legacyUuidForId(c.id), { entry: c, redirect: true });
    push(c.id, preOkfUuidForId(c.id), { entry: c, redirect: true });
  }
  // RFC 0015: archived versions with no file left on disk. Collections win —
  // a uuid already emitted above (live redirect or legacy version file)
  // keeps its current behavior; only the gone ones resolve from history.
  for (const h of listHistoryEntries()) {
    if ((h.lang || "en") === "pt") continue;
    const rawUrl = historyRawPath(h); // null when the blob is unreachable
    for (const uuid of historyUuids(h)) {
      push(h.slug, uuid, { archived: h, rawUrl, redirect: false });
    }
  }
  return paths;
}

type Props = PageProps;
const { entry, redirect, archived } = Astro.props;
const slug = archived ? archived.slug : slugOf(entry!.id);
const live = `/blog/${slug}/`;
if (redirect) return Astro.redirect(live);

let title: string;
let description: string | undefined;
let lang: string | undefined;
let verDate: Date | undefined;
let msg: string | undefined;
let rawUrl: string | null;
let githubUrl: string;
if (archived) {
  title = archived.title || slug;
  description = archived.description || undefined;
  lang = archived.lang || "en";
  const dateStr = archived.draftCommittedAt ?? archived.date;
  verDate = dateStr ? new Date(dateStr) : undefined;
  msg = archived.draftMsg ?? undefined;
  rawUrl = Astro.props.rawUrl ?? null;
  githubUrl = historyGithubUrl(archived);
} else {
  const data = entry!.data;
  title = data.title;
  description = data.description;
  lang = data.lang;
  verDate = data.draftCommittedAt ? new Date(data.draftCommittedAt) : data.date;
  msg = data.draftMsg;
  const urls = archivedContentUrls(entry!.id);
  rawUrl = urls.rawUrl;
  githubUrl = urls.githubUrl ?? `https://github.com/${GITHUB_REPO}`;
}
---

<PageLayout
  title={`${title} — versão arquivada`}
  description={description}
  type="article"
  lang={lang}
  canonicalOverride={live}
  noindex={true}
>
  <div class="post-grid">
    <div class="post-body">
      <Breadcrumbs
        lang={lang}
        items={[
          { name: "Home", href: "/" },
          { name: "Archive", href: "/archive/" },
          { name: title, href: live },
          { name: "versão arquivada", href: Astro.url.pathname },
        ]}
      />

      <VersionBanner liveHref={live} date={verDate} lang={lang} msg={msg} />

      <article data-pagefind-ignore lang={lang ?? "en"}>
        <header><h1>{title}</h1></header>
        <ArchivedContent rawUrl={rawUrl} githubUrl={githubUrl} lang={lang} />
      </article>

      <MermaidEnhancer />
      <BackToTop lang={lang ?? "en"} />
    </div>
  </div>
</PageLayout>
