---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import BackToTop from '../../components/BackToTop.astro';
import ShareButton from '../../components/ShareButton.astro';
import CodeCopyEnhancer from '../../components/CodeCopyEnhancer.astro';
import MermaidEnhancer from '../../components/MermaidEnhancer.astro';
import Webmentions from '../../components/Webmentions.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import AuthorBio from '../../components/AuthorBio.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getRankByKey } from '../../lib/hronir-rank';
import HronirReviews from '../../components/HronirReviews.astro';
import Comments from '../../components/Comments.astro';
import SeriesContext from '../../components/SeriesContext.astro';
import PostActionBar from '../../components/PostActionBar.astro';
import PostNav from '../../components/PostNav.astro';
import { getSeriesContext } from '../../lib/series';
import { isPublished } from '../../lib/publish';
import { t, targetCopy, locale as localeFor, urlPrefix, DEFAULT_LANG } from '../../lib/i18n';
import { isoDuration } from '../../lib/suno';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.filter((post) => isPublished(post)).map((post) => ({
    params: { slug: post.data.slug ?? post.id },
    props: post,
  }));
}
type Props = CollectionEntry<'blog'>;

// Public URL for any post — `slug` overrides the file-derived `id` when
// present. Every internal link on this page should go through this, not
// build `/blog/${p.id}/` directly.
function postUrl(p: CollectionEntry<'blog'>): string {
  const l = p.data.lang ?? DEFAULT_LANG;
  const s = p.data.slug ?? p.id;
  return l === 'pt' ? `/pt/blog/${s}/` : `/blog/${s}/`;
}

const post = Astro.props;
if (post.data.lang === 'pt') {
  return Astro.redirect(postUrl(post));
}
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const { heroImage, heroImageAlt, title, description, date, tags, lang, translationKey, previousVersion, postType, sunoId, genre, duration, sunoImageUrl, tracks } = post.data;
const minutesRead: number | undefined = remarkPluginFrontmatter.minutesRead;
const wordCount: number | undefined = minutesRead ? minutesRead * 200 : undefined;
const hasMath: boolean = !!remarkPluginFrontmatter.hasMath;
const lastModifiedISO: string | undefined = remarkPluginFrontmatter.lastModified;
const lastModified = lastModifiedISO ? new Date(lastModifiedISO) : undefined;
const MS_PER_DAY = 24 * 60 * 60 * 1000;
const showUpdated = lastModified && lastModified.valueOf() - date.valueOf() > MS_PER_DAY;

const rankInfo = translationKey ? getRankByKey().get(translationKey) : undefined;
const postLang: string = lang ?? DEFAULT_LANG;
const rankLabel = postLang === 'pt' ? 'ranking Hrönir' : 'Hrönir rank';
const rankHref = translationKey
  ? `/ranking/posts/${translationKey}/`
  : postLang === 'pt' ? '/pt/ranking/' : '/ranking/';
const series = await getSeriesContext(post, { lang: postLang });
const locale = localeFor(lang);
const dateOpts = { year: 'numeric', month: 'long', day: 'numeric' } as const;
const tagsPrefix = `${urlPrefix(lang)}/tags`;

const allPosts = await getCollection('blog');
const sameLangPosts = allPosts
  .filter((p) => isPublished(p) && (p.data.lang ?? DEFAULT_LANG) === postLang)
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const postIdx = sameLangPosts.findIndex((p) => p.id === post.id);
const prevPost = postIdx > 0 ? sameLangPosts[postIdx - 1] : null;
const nextPost = postIdx < sameLangPosts.length - 1 ? sameLangPosts[postIdx + 1] : null;
const prevNav = prevPost ? { href: postUrl(prevPost), title: prevPost.data.title, date: prevPost.data.date } : null;
const nextNav = nextPost ? { href: postUrl(nextPost), title: nextPost.data.title, date: nextPost.data.date } : null;
// Music-specific navigation: replaces PostNav for music posts
const musicSameLangPosts = postType === 'music'
  ? sameLangPosts.filter((p) => p.data.postType === 'music')
  : [];
const musicIdx = postType === 'music' ? musicSameLangPosts.findIndex((p) => p.id === post.id) : -1;
const prevMusicPost = musicIdx > 0 ? musicSameLangPosts[musicIdx - 1] : null;
const nextMusicPost = musicIdx !== -1 && musicIdx < musicSameLangPosts.length - 1 ? musicSameLangPosts[musicIdx + 1] : null;
const prevMusicNav = prevMusicPost ? { href: postUrl(prevMusicPost), title: prevMusicPost.data.title } : null;
const nextMusicNav = nextMusicPost ? { href: postUrl(nextMusicPost), title: nextMusicPost.data.title } : null;
const translationSiblings = translationKey
  ? allPosts.filter((p) => p.data.translationKey === translationKey && p.id !== post.id)
  : [];
const translations: Record<string, string> = Object.fromEntries(
  translationSiblings.map((p) => [p.data.lang ?? DEFAULT_LANG, postUrl(p)]),
);
const translationLinks = translationSiblings.map((p) => {
  const targetLang = p.data.lang ?? DEFAULT_LANG;
  return {
    href: postUrl(p),
    label: targetCopy(lang, targetLang).invitation,
  };
});

// RFC 0006 / issue #678: MusicRecording rich result for music posts.
// A post is a flat playlist — the legacy singular sunoId/genre/duration/
// sunoStyle/sunoImageUrl fields (kept for the ~150 posts that only ever had
// one Suno rendition) are folded into the same list as `tracks[]`, with no
// primary/secondary distinction. Duration is rounded once here so the
// visible badges below and the JSON-LD can't disagree for a non-integer
// value.
const allTracks = postType === 'music'
  ? [
      ...(sunoId ? [{ label: title, sunoId, sunoImageUrl, genre, duration }] : []),
      ...(tracks ?? []),
    ].map((tr) => ({ ...tr, duration: tr.duration ? Math.round(tr.duration) : undefined }))
  : [];
const musicRecordings = allTracks.map((tr) => ({
  '@context': 'https://schema.org',
  '@type': 'MusicRecording',
  name: tr.label,
  url: Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname,
  byArtist: {
    '@type': 'Person',
    name: 'Franklin Baldo',
    url: Astro.site ? new URL('/about/', Astro.site).href : '/about/',
  },
  recordingOf: {
    '@type': 'MusicComposition',
    name: tr.label,
  },
  embedUrl: `https://suno.com/embed/${tr.sunoId}`,
  ...(tr.sunoImageUrl && { image: tr.sunoImageUrl }),
  ...(tr.genre?.length && { genre: tr.genre }),
  ...(tr.duration && tr.duration > 0 && { duration: isoDuration(tr.duration) }),
}));
---

<PageLayout
  title={title}
  description={description}
  image={heroImage?.src ?? `/og/${post.id}.png`}
  type="article"
  publishedTime={date}
  modifiedTime={lastModified}
  tags={tags}
  lang={lang}
  translations={translations}
  hasMath={hasMath}
  wordCount={wordCount}
>
  {musicRecordings.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} is:inline slot="head" />
  ))}

  <progress
    id="read-progress"
    max="100"
    value="0"
    aria-label={postLang === 'pt' ? 'Progresso de leitura' : 'Reading progress'}
  ></progress>

  <aside class="border-rail" aria-hidden="true">
    <span>{postLang === 'pt' ? 'NOTAS · DA · FRONTEIRA' : 'NOTES · FROM · THE · BORDER'}</span>
  </aside>

  <div class="post-grid">
    <aside class="toc-col" aria-label={t(lang, 'toc.label')}>
      <TableOfContents headings={headings} lang={lang} sidebar />
    </aside>

    <div class="post-body">
      <Breadcrumbs
        lang={postLang}
        items={[
          { name: t(lang, 'nav.home'), href: `${urlPrefix(lang)}/` },
          { name: t(lang, 'nav.archive'), href: `${urlPrefix(lang)}/archive/` },
          { name: title, href: Astro.url.pathname },
        ]}
      />

      <article data-pagefind-body data-pagefind-filter={`lang:${lang}`} lang={postLang}>
        <header>
          <hgroup>
            <h1>{title}</h1>
            <p>
              <small>
                <time datetime={date.toISOString()}>{date.toLocaleDateString(locale, dateOpts)}</time>
                {minutesRead && <> · <span class="reading-badge">{minutesRead} {t(lang, 'post.minutesRead')}</span></>}
                {showUpdated && lastModified && (
                  <> · {t(lang, 'post.updated')} <time datetime={lastModified.toISOString()}>
                    {lastModified.toLocaleDateString(locale, dateOpts)}
                  </time></>
                )}
                {rankInfo && (
                  <> · <a href={rankHref} title={`μ ${rankInfo.row.mu.toFixed(2)}, σ ${rankInfo.row.sigma.toFixed(2)}, ${rankInfo.row.wins}/${rankInfo.row.appearances}`}>{rankLabel} #{rankInfo.rank}/{rankInfo.total}</a></>
                )}
              </small>
            </p>
          </hgroup>
          {postType === 'music' && allTracks.length > 0 && (
            <div class="music-playlist">
              {allTracks.map((tr) => (
                <div class="music-header">
                  <img
                    class="music-cover"
                    src={tr.sunoImageUrl || `https://cdn2.suno.ai/${tr.sunoId}_image.jpeg`}
                    alt={`${t(lang, 'post.coverAlt')} ${tr.label}`}
                    width="120"
                    height="120"
                    loading="lazy"
                  />
                  <div class="music-meta">
                    <p class="music-track-label"><strong>{tr.label}</strong></p>
                    {tr.genre && tr.genre.length > 0 && (
                      <p class="music-genres">
                        {tr.genre.map((g) => <kbd class="genre-pill">{g}</kbd>)}
                      </p>
                    )}
                    {tr.duration && (
                      <p class="music-duration">
                        <small>{Math.floor(tr.duration / 60)}:{String(tr.duration % 60).padStart(2, '0')}</small>
                      </p>
                    )}
                    <button
                      class="music-play-btn"
                      type="button"
                      data-suno-id={tr.sunoId}
                      data-suno-title={tr.label}
                      aria-label={`${t(lang, 'post.playAriaLabel')} ${tr.label}`}
                    >
                      {t(lang, 'post.play')}
                    </button>
                    <a
                      href={`https://suno.com/song/${tr.sunoId}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="music-suno-link"
                    >
                      {t(lang, 'post.listenOnSuno')}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          )}
          {postType !== 'music' && heroImage && (
            <figure class="hero-figure">
              <Image
                src={heroImage}
                alt={heroImageAlt ?? ''}
                widths={[480, 800, 1200]}
                sizes="(max-width: 800px) 100vw, 800px"
                format="webp"
                loading="eager"
                fetchpriority="high"
              />
              {heroImageAlt && <figcaption>{heroImageAlt}</figcaption>}
            </figure>
          )}
        </header>

        {series && <SeriesContext series={series} lang={lang ?? DEFAULT_LANG} variant="aside" />}

        <TableOfContents headings={headings} lang={lang} />

        <Content />

        <footer>
          {tags && tags.length > 0 && (
            <p><small>
              {t(lang, 'post.tags')} {tags.map((tag, i) => (
                <>{i > 0 && ' '}<a class="tag-pill" href={`${tagsPrefix}/${tag}/`}>#{tag}</a></>
              ))}
            </small></p>
          )}
          {translationLinks.length > 0 && (
            <p><small>
              {translationLinks.map((link, i) => (
                <>{i > 0 && ' · '}<a href={link.href}>{link.label}</a></>
              ))}
            </small></p>
          )}
          {previousVersion && (
            <p><small>
              {t(lang, 'post.previousVersion')}:{' '}
              <a href={previousVersion.url} rel="external nofollow" title={previousVersion.msg}>
                <time datetime={previousVersion.timestamp}>
                  {new Date(previousVersion.timestamp).toLocaleDateString(locale, dateOpts)}
                </time>
              </a>
              {previousVersion.msg && <> — <span class="prev-msg">{previousVersion.msg}</span></>}
            </small></p>
          )}
          <ShareButton title={title} lang={lang} />
        </footer>
      </article>

      <AuthorBio lang={lang} />

      {translationKey && <HronirReviews translationKey={translationKey} lang={lang} />}

      <RelatedPosts currentId={post.id} tags={tags ?? []} lang={lang} postType={postType} />

      {series && <SeriesContext series={series} lang={lang ?? DEFAULT_LANG} variant="nav" />}

      {postType === 'music' ? (
        <nav class="music-post-nav" aria-label="Music navigation">
          <a href="/music/">← All music</a>
          <div class="music-post-nav-adjacent">
            {prevMusicNav && <a href={prevMusicNav.href} rel="prev">← {prevMusicNav.title}</a>}
            {nextMusicNav && <a href={nextMusicNav.href} rel="next">{nextMusicNav.title} →</a>}
          </div>
        </nav>
      ) : (
        <PostNav prev={prevNav} next={nextNav} lang={lang} />
      )}

      <Webmentions url={new URL(Astro.url.pathname, Astro.site!)} lang={postLang} />

      <Comments lang={lang} />

      <BackToTop lang={postLang} />
      <CodeCopyEnhancer lang={postLang} />
      <MermaidEnhancer />
    </div>
  </div>

  <PostActionBar
    title={title}
    url={new URL(Astro.url.pathname, Astro.site!).href}
    date={date}
    lang={lang}
  />

  <script is:inline>
    (() => {
      function bindPlayBtns() {
        document.querySelectorAll('.music-play-btn').forEach((btn) => {
          if (btn.dataset.bound === '1') return;
          btn.dataset.bound = '1';
          btn.addEventListener('click', () => {
            document.dispatchEvent(new CustomEvent('gp:play', {
              detail: { sunoId: btn.dataset.sunoId, title: btn.dataset.sunoTitle },
            }));
          });
        });
      }
      bindPlayBtns();
      document.addEventListener('astro:page-load', bindPlayBtns);
    })();
  </script>

  <script is:inline>
    (() => {
      // Drop cap: only apply to the first direct-child <p> of the article
      // when it has enough text to look good with a large initial capital.
      function applyDropCap() {
        const article = document.querySelector('.post-body > article');
        if (!article) return;
        const firstP = article.querySelector(':scope > p');
        if (!firstP) return;
        if ((firstP.textContent ?? '').trim().length >= 80) {
          firstP.setAttribute('data-dropcap', '');
        }
      }
      applyDropCap();
      document.addEventListener('astro:page-load', applyDropCap);
    })();
  </script>

  <script is:inline>
    (() => {
      const bar = document.getElementById('read-progress');
      if (!bar) return;
      const update = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        const pct = max > 0 ? Math.round((h.scrollTop / max) * 100) : 0;
        bar.value = pct;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    })();
  </script>
</PageLayout>

<style>
  /* Native <progress> styled to fit the editorial palette. Uses
     accent-color so Pico's primary token drives both the fill and the
     focus ring. Stays fixed to the top of the viewport while reading. */
  progress#read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    width: 100%;
    height: 3px;
    appearance: none;
    border: 0;
    background: transparent;
    accent-color: var(--pico-primary);
    z-index: 50;
    pointer-events: none;
  }
  progress#read-progress::-webkit-progress-bar { background: transparent; }
  progress#read-progress::-webkit-progress-value { background: var(--pico-primary); }
  progress#read-progress::-moz-progress-bar { background: var(--pico-primary); }

  /* Decorative left rail — desktop only, purely typographic. */
  .border-rail {
    display: none;
  }
  @media (min-width: 1400px) {
    .border-rail {
      display: block;
      position: fixed;
      left: 1.25rem;
      top: 50%;
      transform: translateY(-50%) rotate(180deg);
      writing-mode: vertical-rl;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.32em;
      color: var(--pico-muted-color);
      pointer-events: none;
      user-select: none;
    }
    .border-rail span::after {
      content: "";
      display: inline-block;
      margin-top: 0.75rem;
      width: 1px;
      height: 2.5rem;
      background: var(--pico-muted-color);
      opacity: 0.5;
    }
  }

  .music-playlist {
    margin: 1.5rem 0 2rem;
  }
  .music-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1rem;
    margin: 0 0 0.75rem;
    background: var(--pico-card-background-color);
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
  }
  .music-header:last-child {
    margin-bottom: 0;
  }
  .music-cover {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    object-fit: cover;
    border-radius: calc(var(--pico-border-radius) * 0.75);
  }
  .music-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
  }
  .music-track-label {
    margin: 0;
  }
  .music-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin: 0;
  }
  .genre-pill {
    font-size: 0.7rem;
    padding: 0.1em 0.5em;
  }
  .music-duration {
    margin: 0;
    color: var(--pico-muted-color);
  }
  .music-play-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1.25rem;
    background: var(--pico-primary);
    color: var(--pico-primary-inverse, #fff);
    border: none;
    border-radius: var(--pico-border-radius);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    width: fit-content;
  }
  .music-suno-link {
    font-size: 0.85rem;
    color: var(--pico-muted-color);
    text-decoration: none;
  }
  .music-suno-link:hover { text-decoration: underline; }

  @media (max-width: 480px) {
    .music-header { flex-direction: column; }
    .music-cover { width: 96px; height: 96px; }
  }

  .music-post-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--pico-muted-border-color);
    border-radius: var(--pico-border-radius);
    font-size: 0.9rem;
  }
  .music-post-nav a { text-decoration: none; color: var(--pico-primary); }
  .music-post-nav a:hover { text-decoration: underline; }
  .music-post-nav-adjacent {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-figure {
    margin: 1.5rem 0 2rem;
    text-align: center;
  }
  .hero-figure img {
    width: 100%;
    height: auto;
    border-radius: 4px;
  }
  .hero-figure figcaption {
    margin-top: 0.5rem;
    font-family: var(--pico-font-family-serif);
    font-size: 0.85rem;
    font-style: italic;
    color: var(--pico-muted-color);
  }
</style>
