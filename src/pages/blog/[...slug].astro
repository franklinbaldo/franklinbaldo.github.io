---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};

const readingTime = Math.max(1, Math.round(post.body.length / 1000));

const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "image": post.data.heroImage ? new URL(post.data.heroImage, Astro.site) : undefined,
  "author": {
    "@type": "Person",
    "name": post.data.author || "Franklin Baldo"
  },
  "datePublished": post.data.date.toISOString(),
  "dateModified": post.data.updatedDate ? post.data.updatedDate.toISOString() : post.data.date.toISOString(),
  "url": new URL(Astro.url.pathname, Astro.site)
};
---

<Layout title={post.data.title} description={post.data.description} image={post.data.heroImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="post">
    <header class="post-header">
      <div class="post-meta-top">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <span class="meta-sep">&middot;</span>
        <span>{readingTime} min read</span>
      </div>
      <h1>{post.data.title}</h1>
      {post.data.description && (
        <p class="post-lede">{post.data.description}</p>
      )}
    </header>

    {post.data.heroImage && (
      <figure class="post-hero">
        <img src={post.data.heroImage} alt={post.data.title} loading="eager" />
      </figure>
    )}

    <div class="post-content">
      <Content />
    </div>

    <footer class="post-footer">
      <div class="post-end-mark">&#10070;</div>
      <div class="post-nav">
        <a href="/">&larr; All Essays</a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .post {
    padding-bottom: 2rem;
  }

  .post-header {
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .post-meta-top {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    margin-bottom: 1rem;
  }

  .meta-sep {
    margin: 0 0.5rem;
  }

  .post-header h1 {
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 0.75rem 0;
    color: var(--color-text);
    max-width: 22ch;
    margin-left: auto;
    margin-right: auto;
  }

  .post-lede {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-muted);
    line-height: 1.55;
    max-width: 42ch;
    margin: 0 auto;
  }

  .post-hero {
    margin: 2.5rem -3rem 3rem;
    padding: 0;
  }

  .post-hero img {
    width: 100%;
    display: block;
  }

  .post-footer {
    margin-top: 3rem;
    text-align: center;
  }

  .post-end-mark {
    color: var(--color-border);
    font-size: 1.2rem;
    margin-bottom: 2rem;
  }

  .post-nav {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-nav a {
    color: var(--color-muted);
    border-bottom: none;
  }

  .post-nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.8rem;
    }

    .post-hero {
      margin-left: -1.5rem;
      margin-right: -1.5rem;
    }
  }
</style>

<style is:global>
  /* ── Post Content Typography (Craig Mod-inspired) ── */

  .post-content {
    text-align: justify;
    hyphens: auto;
  }

  .post-content h2 {
    font-size: 1.45rem;
    font-weight: 700;
    margin-top: 3em;
    margin-bottom: 0.75em;
    color: var(--color-text);
    text-align: left;
  }

  .post-content h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-top: 2.5em;
    margin-bottom: 0.5em;
    color: var(--color-text);
    text-align: left;
  }

  .post-content p {
    margin-bottom: 1.5rem;
    line-height: 1.78;
  }

  /* Links — clean underline, Craig Mod style */
  .post-content a {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    transition: border-color 0.15s ease;
  }

  .post-content a:hover {
    border-bottom-color: var(--color-text);
  }

  .post-content blockquote {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.5rem;
    color: var(--color-muted);
    font-style: italic;
    margin: 2.5em 0;
    text-align: left;
  }

  .post-content code {
    font-family: var(--font-mono);
    background: var(--color-surface);
    padding: 0.15em 0.35em;
    border-radius: 2px;
    font-size: 0.85em;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .post-content pre {
    background: var(--color-surface) !important;
    padding: 1.25rem;
    border-radius: 2px;
    border: 1px solid var(--color-border);
    overflow-x: auto;
    margin: 2.5em 0;
    text-align: left;
  }

  .post-content pre code {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-text);
  }

  .post-content ul {
    list-style-type: disc;
    padding-left: 1.5em;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .post-content ol {
    list-style-type: decimal;
    padding-left: 1.5em;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .post-content li {
    margin-bottom: 0.4em;
  }

  .post-content hr {
    border: none;
    text-align: center;
    margin: 3em 0;
  }

  .post-content hr::after {
    content: "* * *";
    color: var(--color-muted);
    font-size: 0.85rem;
    letter-spacing: 0.5em;
  }

  .post-content strong {
    font-weight: 700;
    color: var(--color-text);
  }

  /* Full-bleed images — break out of text column */
  .post-content img {
    margin: 2.5em -3rem;
    display: block;
    width: calc(100% + 6rem);
    max-width: calc(100% + 6rem);
    border: none;
    border-radius: 0;
  }

  @media (max-width: 640px) {
    .post-content img {
      margin-left: -1.5rem;
      margin-right: -1.5rem;
      width: calc(100% + 3rem);
      max-width: calc(100% + 3rem);
    }
  }
</style>
