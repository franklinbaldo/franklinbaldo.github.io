---
import PageLayout from "../layouts/PageLayout.astro";
---

<PageLayout title="Search | Franklin Baldo" description="Full-text search across the garden." translationHref="/pt/search/">
  <hgroup>
    <h1>Search</h1>
    <p><small>Full-text search across all essays. Index built with <a href="https://pagefind.app/">Pagefind</a>.</small></p>
  </hgroup>

  <search id="search"></search>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline defer src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    function initSearch() {
      if (window.PagefindUI && document.getElementById("search") && !document.querySelector("#search .pagefind-ui")) {
        new window.PagefindUI({ element: "#search", showImages: false, showSubResults: true });
      }
    }
    window.addEventListener("DOMContentLoaded", initSearch);
    document.addEventListener("astro:page-load", initSearch);
  </script>
</PageLayout>
