---
import PageLayout from "../layouts/PageLayout.astro";
import { XMLParser } from "fast-xml-parser";

const GOODREADS_RSS = "https://www.goodreads.com/review/list_rss/5942034?shelf=read";
const GOODREADS_PROFILE = "https://www.goodreads.com/user/show/5942034";

interface GoodreadsItem {
  title: string;
  link: string;
  author_name: string;
  book_image_url: string;
  user_rating: number;
  user_read_at: string;
  book_published: string | number;
  book_description?: string;
}

let books: GoodreadsItem[] = [];
let error: string | null = null;

try {
  const res = await fetch(GOODREADS_RSS);
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const xml = await res.text();

  const parser = new XMLParser({
    ignoreAttributes: false,
    cdataPropName: "__cdata",
    isArray: (name) => name === "item",
  });
  const parsed = parser.parse(xml);
  const items: Record<string, unknown>[] = parsed?.rss?.channel?.item ?? [];

  books = items.map((item) => {
    const str = (v: unknown) =>
      typeof v === "object" && v !== null && "__cdata" in v
        ? String((v as Record<string, unknown>)["__cdata"])
        : String(v ?? "");

    const imageUrl = str(item["book_image_url"]);
    // Upgrade small thumbnail (_SY75_) to a larger size
    const coverUrl = imageUrl.replace("._SY75_.", "._SX200_.").replace("._SX98_.", "._SX200_.");

    return {
      title: str(item["title"]),
      link: str(item["link"]),
      author_name: str(item["author_name"]),
      book_image_url: coverUrl || imageUrl,
      user_rating: Number(item["user_rating"]) || 0,
      user_read_at: str(item["user_read_at"]),
      book_published: str(item["book_published"]),
    };
  });

  // Sort: books with a read date first (most recent), then unread-dated books
  books.sort((a, b) => {
    if (!a.user_read_at && !b.user_read_at) return 0;
    if (!a.user_read_at) return 1;
    if (!b.user_read_at) return -1;
    return new Date(b.user_read_at).valueOf() - new Date(a.user_read_at).valueOf();
  });
} catch (e) {
  error = e instanceof Error ? e.message : String(e);
  console.warn(`[books] failed to fetch Goodreads RSS: ${error}`);
}

const fmtDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
});

function stars(rating: number): string {
  if (!rating) return "";
  return "★".repeat(rating) + "☆".repeat(5 - rating);
}

const booksJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Books Read by Franklin Baldo",
  "description": "Books Franklin Baldo has read, sourced from Goodreads.",
  "url": "https://franklinbaldo.github.io/books/",
  "numberOfItems": books.length,
  "itemListElement": books.slice(0, 20).map((b, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Book",
      "name": b.title,
      "author": { "@type": "Person", "name": b.author_name },
      "url": b.link,
    },
  })),
};
---

<PageLayout
  title="Books | Franklin Baldo"
  description="Books I've read, fetched from my Goodreads shelf."
  lang="en"
  translations={{ pt: "/pt/livros/" }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(booksJsonLd)} is:inline />
  <hgroup>
    <h1>Books</h1>
    <p><small>
      Books I've read, sourced from my
      <a href={GOODREADS_PROFILE}>Goodreads shelf</a> · {books.length} books · updated at build time.
    </small></p>
  </hgroup>

  {error && (
    <p><small>
      Couldn't load books right now (<code>{error.slice(0, 120)}</code>).
      See them directly on <a href={GOODREADS_PROFILE}>Goodreads</a>.
    </small></p>
  )}

  {books.length > 0 && (
    <div class="books-grid">
      {books.map((book) => {
        const readDate = book.user_read_at
          ? fmtDate.format(new Date(book.user_read_at.replace(/\//g, "-")))
          : null;
        const rating = stars(book.user_rating);
        const pubYear = book.book_published ? String(book.book_published) : null;

        return (
          <article class="book-card">
            <a href={book.link} class="cover-link">
              <img
                src={book.book_image_url}
                alt={`Cover of ${book.title}`}
                loading="lazy"
                width="200"
                height="300"
              />
            </a>
            <div class="book-info">
              <h2><a href={book.link}>{book.title}</a></h2>
              <p class="author">{book.author_name}</p>
              {rating && <p class="rating" aria-label={`${book.user_rating} out of 5 stars`}>{rating}</p>}
              <p class="meta">
                <small>
                  {readDate && <>Read {readDate}</>}
                  {readDate && pubYear && <> · </>}
                  {pubYear && Number(pubYear) > 0 && <>Published {pubYear}</>}
                </small>
              </p>
            </div>
          </article>
        );
      })}
    </div>
  )}
</PageLayout>

<style>
  .books-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1.5rem;
  }

  .book-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cover-link img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: var(--pico-border-radius);
  }

  .book-info h2 {
    font-size: 0.9rem;
    margin: 0 0 0.2rem;
    line-height: 1.3;
  }

  .book-info h2 a {
    text-decoration: none;
  }

  .book-info h2 a:hover {
    text-decoration: underline;
  }

  .book-info .author {
    font-size: 0.8rem;
    color: var(--pico-muted-color);
    margin: 0 0 0.2rem;
  }

  .book-info .rating {
    font-size: 0.85rem;
    color: var(--pico-primary);
    margin: 0 0 0.2rem;
    letter-spacing: 0.05em;
  }

  .book-info .meta {
    margin: 0;
  }
</style>
