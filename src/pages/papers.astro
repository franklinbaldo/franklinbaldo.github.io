  { file:"embedding_seeded_tournament.md", title:"ESHTR: torneios semânticos entre hipóteses", family:"Método formal", kind:"avaliação por LLM", scientificTier:"C", interestTier:"A", confidence:"medium", idea:"Usa embeddings para montar grupos comparáveis e depois um painel de modelos para julgar hipóteses, tentando reduzir comparações arbitrárias entre coisas semanticamente muito distantes.", status:"Método experimental de avaliação.", limit:"O painel continua herdando vieses e correlações dos modelos avaliadores; precisa de calibração externa." },
