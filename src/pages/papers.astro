  { file:"paper1E_custos_argumentativos.md", title:"Custos argumentativos", family:"Raciocínio jurídico auditável", kind:"conceitual/jurídico", scientificTier:"C", interestTier:"A", confidence:"medium", idea:"Olha para argumentos jurídicos como escolhas que têm custos: quanto mais uma decisão se afasta de uma rota institucional esperada, mais precisa explicar e sustentar esse desvio.", status:"Explora uma dimensão comparativa da fundamentação.", limit:"O conceito ainda precisa de métricas e casos que mostrem quando o custo é realmente discriminante." },
  { file:"paper1F_reputacao_sistema_juridico.md", title:"Reputação no sistema jurídico", family:"Raciocínio jurídico auditável", kind:"conceitual/jurídico", scientificTier:"C", interestTier:"A", confidence:"low", idea:"Investiga se reputação e histórico institucional funcionam como uma camada de informação que influencia o comportamento jurídico mesmo quando isso não aparece diretamente na regra escrita.", status:"Linha conceitual da série.", limit:"É difícil separar reputação de incentivos, hierarquia e seleção institucional sem desenho empírico próprio." },
  { file:"paper1G_livre_convencimento_patrimonialismo.md", title:"Livre convencimento e patrimonialismo", family:"Raciocínio jurídico auditável", kind:"histórico/dogmático", scientificTier:"C", interestTier:"A", confidence:"medium", idea:"Pergunta se certas formas de liberdade decisória no processo brasileiro carregam heranças institucionais mais antigas — e submete essa hipótese a ciclos adversariais de crítica e revisão.", status:"Paper vivo com forte aparato de debate interno.", limit:"A atribuição causal histórica é difícil; várias explicações estruturais concorrentes continuam plausíveis." },
