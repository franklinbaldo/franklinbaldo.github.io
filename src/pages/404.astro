---
import { getCollection } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import { isPublished } from "../lib/publish";

const recent = (await getCollection("blog"))
  .filter((p) => isPublished(p))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<PageLayout title="Not Found | Franklin Baldo" description="Page not found." lang="en" translations={{ pt: "/pt/404/" }}>
  <hgroup>
    <h1>404</h1>
    <p>That page doesn’t exist — or it has been pruned from the garden.</p>
  </hgroup>

  <section aria-labelledby="search-heading">
    <h2 id="search-heading">Search</h2>
    <search>
      <pagefind-searchbox></pagefind-searchbox>
    </search>
  </section>

  <nav aria-label="Recently published">
    <h2>Recently published</h2>
    <ul>
      {recent.map((post) => (
        <li>
          <a href={post.data.lang === "pt" ? `/pt/blog/${post.id}/` : `/blog/${post.id}/`}>{post.data.title}</a>
          {' — '}
          <small>
            <time datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString("en-US", { month: "short", day: "2-digit", year: "numeric" })}
            </time>
          </small>
        </li>
      ))}
    </ul>
  </nav>

  <nav aria-label="Other pages">
    <p>
      Or try the <a href="/">home page</a>, the <a href="/archive/">archive</a>,
      or browse by <a href="/tags/">tag</a>.
    </p>
  </nav>

  <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
  <script is:inline type="module" src="/pagefind/pagefind-component-ui.js"></script>
</PageLayout>
