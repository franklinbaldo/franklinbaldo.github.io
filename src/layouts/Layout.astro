---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  wide?: boolean;
}

const { title, description = "A digital memory palace.", image, type = "website", wide = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <ClientRouter />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Franklin Baldo" />
    <meta property="og:locale" content="en_US" />
    {image && <meta property="og:image" content={new URL(image, Astro.url)} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {image && <meta property="twitter:image" content={new URL(image, Astro.url)} />}

    <!-- Typography Enhancement -->
    <link rel="stylesheet" href="/css/gwern-typography.css" />
  </head>
  <body>
    <div class="site-wrapper">
      <header class="site-header">
        <div class="header-brand">
          <a href="/" class="site-logo" aria-label="Home">
            <svg width="42" height="42" viewBox="0 0 42 42" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="21" cy="21" r="21" fill="#393939"/>
              <text x="21" y="27" text-anchor="middle" fill="#fff" font-family="Georgia, serif" font-size="20" font-weight="700">FB</text>
            </svg>
          </a>
          <a href="/" class="site-name">Franklin Baldo</a>
        </div>
        <nav class="site-nav">
          <div class="nav-group">
            <a href="/about">About</a>
            <a href="/">Essays</a>
          </div>
          <div class="nav-group">
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/franklinbaldo" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-newsletter">
          <p class="footer-cta-label">Stay updated</p>
          <p class="footer-cta-desc">Writing about AI, philosophy, and the architecture of the future.</p>
          <a href="/rss.xml" class="footer-subscribe">Subscribe via RSS &rarr;</a>
        </div>
        <div class="footer-bottom">
          <div class="footer-links">
            <a href="https://github.com/franklinbaldo" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://twitter.com/franklinbaldo" target="_blank" rel="noopener noreferrer">Twitter</a>
            <a href="mailto:franklin@franklinbaldo.com">Email</a>
          </div>
          <p class="footer-copy">&copy; {new Date().getFullYear()} Franklin Baldo</p>
        </div>
      </footer>
    </div>
  </body>
</html>

<style>
  .site-wrapper {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: 0 1.5rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Header ──────────────────────────────────────── */

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .header-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-logo {
    border-bottom: none;
    display: flex;
    align-items: center;
  }

  .site-logo:hover {
    border-bottom: none;
    opacity: 0.8;
  }

  .site-name {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.02em;
    border-bottom: none;
  }

  .site-name:hover {
    color: var(--color-muted);
    border-bottom: none;
  }

  .site-nav {
    display: flex;
    gap: 2rem;
  }

  .nav-group {
    display: flex;
    gap: 1.25rem;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
  }

  .nav-group a {
    color: var(--color-muted);
    border-bottom: none;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  .nav-group a:hover {
    color: var(--color-text);
    border-bottom: none;
  }

  /* ── Main ────────────────────────────────────────── */

  .site-main {
    flex-grow: 1;
  }

  /* ── Footer ──────────────────────────────────────── */

  .site-footer {
    margin-top: auto;
    padding-top: 0;
  }

  .footer-newsletter {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 2.5rem 0;
    margin-top: 4rem;
    text-align: center;
  }

  .footer-cta-label {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-muted);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .footer-cta-desc {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 1rem;
    max-width: 36ch;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .footer-subscribe {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-text);
    font-weight: 500;
    padding-bottom: 1px;
  }

  .footer-subscribe:hover {
    color: var(--color-muted);
    border-bottom-color: var(--color-muted);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 0 2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .footer-links a {
    color: var(--color-muted);
    border-bottom: none;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .footer-copy {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--color-muted);
    margin: 0;
    letter-spacing: 0.02em;
  }

  /* ── Mobile ──────────────────────────────────────── */

  @media (max-width: 640px) {
    .site-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.5rem 0;
      margin-bottom: 2rem;
    }

    .site-nav {
      gap: 1.25rem;
    }

    .nav-group {
      gap: 0.75rem;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
