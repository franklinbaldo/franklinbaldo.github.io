# Keep private agent state only
agent/
.openclaw/

# Secrets
*.env
.env.*
secrets.*
credentials.*

# Runtime lock files

# Session runtime state (not session transcripts)
sessions/sessions.json
sessions/*.lock

# NPM lock files (updates recorrentes locais)
**/package-lock.json

# Build artifacts (gerados, não versionados)
workspace/.astro/
workspace/dist/
workspace/node_modules/
workspace/backup-posts-locais/

# Workspace duplicado (acidental)
workspace/workspace/
