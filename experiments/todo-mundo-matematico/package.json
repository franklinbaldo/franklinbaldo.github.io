{
  "name": "todo-mundo-matematico",
  "version": "1.0.0",
  "description": "Vídeo animado “Todo mundo é matemático agora!” (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "audio": "uv run --with edge-tts --with numpy python tools/build_audio.py && uv run --with numpy python tools/build_music.py && uv run --with numpy python tools/build_sfx.py",
    "lean": "sh lean/verificar.sh && python3 tools/capture_lean.py",
    "dev": "remotion studio",
    "render": "remotion render TodoMundoMatematico out/todo-mundo-e-matematico-agora.mp4 --concurrency=4 --crf=20",
    "lint": "tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
