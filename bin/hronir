#!/usr/bin/env bash
# Thin wrapper so the Hrönir CLI can be invoked without npm's `--` separator.
#   bin/hronir init --agent-id 'this is my id' --matches 10 --skip-edit
# is equivalent to
#   npm run hronir:init -- --agent-id 'this is my id' --matches 10 --skip-edit
# Mirrors the `node --import tsx/esm scripts/hronir/index.js` runner used by
# the package.json scripts.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec node --import tsx/esm "$here/../scripts/hronir/index.js" "$@"
